<Application x:Class="M365Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M365Manager.ViewModels"
             xmlns:views="clr-namespace:M365Manager.Views"
             xmlns:conv="clr-namespace:M365Manager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToCollapsed" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />

            <!-- Map each ViewModel to its View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
                <views:GroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamsViewModel}">
                <views:TeamsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SharedMailboxesViewModel}">
                <views:SharedMailboxesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoomResourcesViewModel}">
                <views:RoomResourcesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamsPoliciesViewModel}">
                <views:TeamsPoliciesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewHireViewModel}">
                <views:NewHireView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TraceViewModel}">
                <views:TraceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
