<UserControl x:Class="M365Manager.Controls.AlertBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:M365Manager.Controls"
             x:Name="Root">

    <!--
        Collapse when there is nothing to say. A style trigger, not a code-behind assignment: a
        local value would override a Visibility binding the consumer sets in XAML, which is exactly
        how a conditional warning ended up showing unconditionally.
    -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <!-- Replaces the grey status line the app used everywhere, which made success, warning and
         error look identical. Colour AND glyph carry the severity, so it still reads in greyscale. -->
    <Border x:Name="Shell" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12"
            BorderThickness="1"
            Background="{DynamicResource InfoSoftBrush}"
            BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Glyph" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Margin="0,1,12,0" VerticalAlignment="Top"
                       Text="&#xE946;" Foreground="{DynamicResource InfoBrush}" />

            <TextBlock Grid.Column="1" Style="{StaticResource Body}"
                       Text="{Binding Text, ElementName=Root}"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
    </Border>
</UserControl>
