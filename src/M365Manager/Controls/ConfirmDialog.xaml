<Window x:Class="M365Manager.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Destructive confirmation. This is the ONLY place solid red appears on a button: inside a
         modal whose whole purpose is the warning, so it cannot be mistaken for the brand accent
         that marks primary actions and the active nav item. -->
    <Border Style="{StaticResource DialogSurface}" MaxWidth="560" Margin="16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource H2}"
                           Margin="16,4,0,0" Text="Delete this group?" />
            </Grid>

            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,0,0,12" />

            <Border x:Name="DetailPanel" Style="{StaticResource Inset}" Margin="0,0,0,16"
                    Visibility="Collapsed">
                <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="Delete" Style="{StaticResource DangerConfirmButton}"
                        Margin="12,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
