<UserControl x:Class="M365Manager.Controls.PowerShellConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="320" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,4"
                   Text="PowerShell" />
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,0,0,10"
                   Text="Every Exchange command this page runs, with its output and any errors - exactly as PowerShell would print it. Sign-in is excluded." />

        <!-- Console. Colours match the classic PowerShell host: dark blue background,
             light grey text, yellow for warnings, red for errors. -->
        <Border Grid.Row="2" CornerRadius="6" Background="#012456" BorderBrush="#0A3A80" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RichTextBox x:Name="Console" Grid.Row="0"
                             Background="Transparent" Foreground="#EEEEEE"
                             BorderThickness="0" Padding="12,10,12,10"
                             FontFamily="Consolas, Courier New" FontSize="12.5"
                             IsReadOnly="True" IsDocumentEnabled="False"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             SelectionBrush="#3A6EA5"
                             MinHeight="180">
                    <RichTextBox.Resources>
                        <!-- Paragraphs default to a margin that would double-space the console. -->
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
                    <Button x:Name="CopyButton" Content="Copy all" Click="CopyButton_Click"
                            Style="{StaticResource SecondaryButtonSmall}"
                            ToolTip="Copies the whole transcript to the clipboard" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonSmall}" />
                    <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              FontFamily="Segoe UI" FontSize="12" Foreground="#BBCCEE" />
                    <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#BBCCEE" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
