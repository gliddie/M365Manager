<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\M365Manager.Core\M365Manager.Core.csproj" />
    <ProjectReference Include="..\M365Manager.Data\M365Manager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.jpg" />
    <Resource Include="Assets\*.png" />
    <!-- Also a Resource, not just ApplicationIcon, so MainWindow can bind Icon= to it and the
         running window/taskbar entry uses the same artwork as the exe. -->
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

  <!-- Ship the bundled ExchangeOnlineManagement module next to the app -->
  <ItemGroup>
    <None Include="Modules\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Embedded in the exe, so Explorer, the taskbar and a pinned start menu tile all show it.
         The .ico carries 16/32/48/64/128/256 px so Windows never has to rescale. -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
