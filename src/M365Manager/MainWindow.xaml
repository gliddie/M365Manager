<Window x:Class="M365Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="M365Manager"
        Height="720" Width="1120"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <Image Source="Assets/logo-banner.jpg" Height="34"
                           HorizontalAlignment="Left" Stretch="Uniform" />
                    <TextBlock Text="M365 Manager" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,12,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItemContainer}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />

                <!-- Footer -->
                <TextBlock Grid.Row="2" Margin="22,0,20,18" Style="{StaticResource Muted}"
                           Text="UL Solutions IT" />
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,18">
                <TextBlock Style="{StaticResource H1}"
                           Text="{Binding SelectedPage.Title}" />
            </Border>

            <!-- Page -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
