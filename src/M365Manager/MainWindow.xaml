<Window x:Class="M365Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="M365Manager"
        Height="720" Width="1120"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <Image Source="Assets/logo-banner.jpg" Height="34"
                           HorizontalAlignment="Left" Stretch="Uniform" />
                    <TextBlock Text="M365 Manager" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,12,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItemContainer}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />

                <!-- Footer -->
                <TextBlock Grid.Row="2" Margin="22,0,20,18" Style="{StaticResource Muted}"
                           Text="UL Solutions IT" />
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,18">
                <TextBlock Style="{StaticResource H1}"
                           Text="{Binding SelectedPage.Title}" />
            </Border>

            <!-- Page -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- ===================== Startup connecting overlay ===================== -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#CC1B1B1B"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisible}}">
            <Border Style="{StaticResource Card}" MaxWidth="480" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Connecting to Microsoft 365" Margin="0,0,0,10" />
                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding ConnectingStatusText}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <!-- Device-code sign-in banner (shown only while a code is pending) -->
                    <Border Margin="0,0,0,14" CornerRadius="8" Padding="18,14"
                            Background="{StaticResource UlRedSoftBrush}" BorderBrush="{StaticResource UlRedBrush}"
                            BorderThickness="1"
                            Visibility="{Binding DeviceCodeMessage, Converter={StaticResource EmptyToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="Sign-in required" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource UlRedDarkBrush}" Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8"
                                        Visibility="{Binding DeviceCode, Converter={StaticResource EmptyToCollapsed}}">
                                <Border Background="White" BorderBrush="{StaticResource UlRedBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="22"
                                               FontWeight="Bold" Foreground="{StaticResource UlRedDarkBrush}" />
                                </Border>
                                <Button Content="Copy code" Style="{StaticResource SecondaryButtonSmall}"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding CopyDeviceCodeCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding DeviceCodeMessage}" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="A browser opens automatically. Paste the code, then sign in with your admin account."
                                       Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="Continue without waiting" Style="{StaticResource SecondaryButtonSmall}"
                            HorizontalAlignment="Right" Command="{Binding DismissConnectingCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
