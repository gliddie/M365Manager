<!--
    Light palette. Colors.Dark.xaml defines the SAME keys with dark values; ThemeService swaps the
    whole dictionary at runtime, so every consumer must reference these via DynamicResource.

    Red carries two meanings in this app and they must not be confused:
      Brand*  - UL Solutions red. Logo, active nav marker, and exactly ONE primary action per
                screen. Nothing else.
      Danger* - destructive actions, and only inside a confirmation dialog. A destructive button
                in its resting state is NOT red (see DangerButton in Styles.xaml) - it is a neutral
                outline with an icon and an explicit verb, so brand red never reads as a warning.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Surfaces ===================== -->
    <Color x:Key="PageColor">#F4F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FAFBFC</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="OverlayColor">#8C1B1B1B</Color>

    <!-- ===================== Lines ===================== -->
    <Color x:Key="BorderColor">#E3E6EA</Color>
    <!-- 3.63:1 against white. WCAG 1.4.11 wants 3:1 for a control boundary, and an input's
         border is the only thing saying where the field is. The old #CBD1D9 measured 1.54. -->
    <Color x:Key="BorderStrongColor">#7E8795</Color>

    <!-- ===================== Text =====================
         TextMuted is #5B6472, not the lighter #6B7280 it used to be: on the page background
         (#F4F5F7) that older value measured 4.43:1 and missed WCAG AA for normal text. This one
         is 5.4:1 there and 5.9:1 on a white card. -->
    <Color x:Key="TextColor">#1F2328</Color>
    <Color x:Key="TextMutedColor">#5B6472</Color>
    <Color x:Key="TextInverseColor">#FFFFFF</Color>
    <Color x:Key="TextDisabledColor">#9AA3AF</Color>

    <!-- ===================== Brand ===================== -->
    <Color x:Key="BrandColor">#CA0123</Color>
    <Color x:Key="BrandHoverColor">#A00019</Color>
    <Color x:Key="BrandSoftColor">#FCE7EB</Color>

    <!-- Brand red has two jobs with opposite contrast needs: a FILL that carries white text
         (BrandColor) and TEXT/glyphs/accent bars drawn in the brand colour (BrandTextColor). In
         light they can be the same value - 5.93:1 either way. In dark they cannot; see that file. -->
    <!-- Label colour for anything sitting ON a brand or danger fill. White in both palettes:
         the fill is dark red either way, so this does NOT follow the theme. Distinct from
         TextInverse, which means "text on an inverted surface" and is near-black in dark. -->
    <Color x:Key="OnBrandColor">#FFFFFF</Color>
    <Color x:Key="BrandTextColor">#CA0123</Color>

    <!-- ===================== Signal ===================== -->
    <Color x:Key="SuccessColor">#1A7F37</Color>
    <Color x:Key="SuccessSoftColor">#E8F5EC</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="WarningSoftColor">#FFFBEB</Color>
    <Color x:Key="DangerColor">#B3261E</Color>
    <Color x:Key="DangerSoftColor">#FDECEA</Color>
    <!-- Same split as Brand: DangerColor is the light-enough tone for danger TEXT and glyphs,
         DangerFillColor the solid red behind the white label of a confirm button. -->
    <Color x:Key="DangerFillColor">#B3261E</Color>
    <Color x:Key="InfoColor">#334155</Color>
    <Color x:Key="InfoSoftColor">#F1F5F9</Color>

    <!-- Focus ring is deliberately neutral. A coloured ring would either clash with the brand red
         or read as a warning; neither is what focus means. -->
    <Color x:Key="FocusColor">#1F2328</Color>

    <!-- ===================== Console =====================
         The in-GUI PowerShell console keeps its dark look in both themes - it mirrors a real
         console - but the values come from here instead of being hardcoded in the control. -->
    <Color x:Key="ConsoleBackColor">#012456</Color>
    <Color x:Key="ConsoleBackAltColor">#0A3A80</Color>
    <Color x:Key="ConsoleTextColor">#EEEEEE</Color>
    <Color x:Key="ConsoleMutedColor">#BBCCEE</Color>
    <Color x:Key="ConsoleAccentColor">#3A6EA5</Color>

    <!-- ===================== Brushes ===================== -->
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
    <SolidColorBrush x:Key="OnBrandBrush" Color="{StaticResource OnBrandColor}" />
    <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="{StaticResource DangerFillColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

    <SolidColorBrush x:Key="ConsoleBackBrush" Color="{StaticResource ConsoleBackColor}" />
    <SolidColorBrush x:Key="ConsoleBackAltBrush" Color="{StaticResource ConsoleBackAltColor}" />
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleTextColor}" />
    <SolidColorBrush x:Key="ConsoleMutedBrush" Color="{StaticResource ConsoleMutedColor}" />
    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="{StaticResource ConsoleAccentColor}" />

</ResourceDictionary>

