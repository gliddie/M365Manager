<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UL Solutions brand palette (sampled from official logo assets) -->
    <Color x:Key="UlRedColor">#CA0123</Color>
    <Color x:Key="UlRedDarkColor">#A00019</Color>
    <Color x:Key="UlRedSoftColor">#FCE7EB</Color>

    <Color x:Key="PageColor">#F4F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E3E6EA</Color>
    <Color x:Key="TextColor">#1F2328</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>

    <Color x:Key="SuccessColor">#1A7F37</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="UlRedBrush" Color="{StaticResource UlRedColor}" />
    <SolidColorBrush x:Key="UlRedDarkBrush" Color="{StaticResource UlRedDarkColor}" />
    <SolidColorBrush x:Key="UlRedSoftBrush" Color="{StaticResource UlRedSoftColor}" />

    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

</ResourceDictionary>
