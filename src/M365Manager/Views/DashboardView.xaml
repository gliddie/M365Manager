<UserControl x:Class="M365Manager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H1}" Text="Welcome" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,22"
                       Text="Modern administration for Microsoft 365 and Azure. Configure your connections in Settings, then use the tools from the navigation on the left." />

            <!-- Status cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="SQL logging" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="{Binding SqlStatus}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="M365 connection" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="{Binding M365Status}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button Style="{StaticResource SecondaryButton}" Content="Refresh status"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Left" Margin="0,18,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
