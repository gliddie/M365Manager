<UserControl x:Class="M365Manager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:log="clr-namespace:M365Manager.Data.Logging;assembly=M365Manager.Data"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <!--
        The landing page, so it opens the work rather than describing the app. Each tile goes
        straight to the form a common ticket asks for - "Page|tabIndex", handled by OpenCommand.
    -->
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="232" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandTextBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32" MaxWidth="980" HorizontalAlignment="Left">

            <!-- Connection state: one line each, not two large cards saying almost nothing. -->
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SqlConfigured}" Value="True">
                                            <Setter Property="Text" Value="&#xE930;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SQL logging" Margin="0" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding SqlStatus}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SignedIn}" Value="True">
                                            <Setter Property="Text" Value="&#xE930;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Microsoft 365" Margin="0" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding M365Status}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="3" Content="_Refresh" Style="{StaticResource GhostButtonSmall}"
                            VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Start a task" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Straight to the form - the ticket number goes in there." />

            <WrapPanel>
                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Groups|1"
                        AutomationProperties.Name="Create a distribution list or group">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE716;" />
                        <TextBlock Style="{StaticResource H3}" Text="Create a group" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Distribution list, security or dynamic group" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Groups|0"
                        AutomationProperties.Name="Find and manage a group">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE721;" />
                        <TextBlock Style="{StaticResource H3}" Text="Manage a group" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Members, owners, senders, aliases" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Shared Mailboxes|1"
                        AutomationProperties.Name="Create a shared mailbox">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE715;" />
                        <TextBlock Style="{StaticResource H3}" Text="Create a shared mailbox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="With its .ED/.AU/.RE access groups" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Shared Mailboxes|0"
                        AutomationProperties.Name="Change a shared mailbox owner or rename it">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE77B;" />
                        <TextBlock Style="{StaticResource H3}" Text="Change mailbox owner" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Or rename a shared mailbox" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Teams|1"
                        AutomationProperties.Name="Create a team">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8BD;" />
                        <TextBlock Style="{StaticResource H3}" Text="Create a team" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Enforced naming, owner, internal or external" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Rooms &amp; Resources|1"
                        AutomationProperties.Name="Create a room or resource">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE787;" />
                        <TextBlock Style="{StaticResource H3}" Text="Create a room" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Room or equipment mailbox with its groups" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="New Hire"
                        AutomationProperties.Name="Enable a new hire for telephony">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8FA;" />
                        <TextBlock Style="{StaticResource H3}" Text="Assign a phone number" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Enable a new hire for Teams telephony" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" CommandParameter="Teams Policies"
                        AutomationProperties.Name="Assign a Teams meeting policy">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE72E;" />
                        <TextBlock Style="{StaticResource H3}" Text="Assign a meeting policy" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Recording, transcription, Copilot" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Recent activity: a run that failed should be visible without opening Logs. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                <TextBlock Style="{StaticResource H2}" Text="Recent activity" VerticalAlignment="Center" />
                <Button Content="Open the _log" Style="{StaticResource GhostButtonSmall}"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding OpenLogsCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="The last eight entries recorded by this app, newest first." />

            <Border Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding RecentEntries.Count, Converter={StaticResource ZeroToCollapsed}}">
                <ItemsControl ItemsSource="{Binding RecentEntries}" Margin="16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type log:LogEntry}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Text" Value="&#xE930;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="1" Style="{StaticResource Muted}"
                                           Text="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm'}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Action}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <controls:AlertBox Text="{Binding RecentStatus}" Severity="{Binding RecentStatusSeverity}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

