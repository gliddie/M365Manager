<UserControl x:Class="M365Manager.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <!--
        Two tasks, two tabs. This page used to stack create, search, members and six management
        blocks into one scroll column, so "Remove group" sat in the same visual rank as "Owners"
        and the create form hid inside a collapsed expander below the search box.

        Now: find-and-manage is the default (that is the ticket workflow - a ticket names a group),
        creating is the other tab, and the management actions are sub-tabs on the selected group so
        only one is on screen at a time.
    -->
    <TabControl Style="{StaticResource TabStrip}" Padding="0"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
        </TabControl.Resources>

        <!-- ================================================================
             Find & manage
             ================================================================ -->
        <TabItem Header="Find &amp; manage">
            <Grid Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Search is the primary action of this tab. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="360"
                                 AutomationProperties.Name="Search groups"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource PrimaryButton}" Content="_Search"
                                Margin="{DynamicResource GapInline}" IsDefault="True"
                                Command="{Binding SearchCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource GhostButton}" Content="C_lear"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding ClearResultsCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Group name, alias or e-mail address. Press Enter to search." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <!-- Results | detail -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <!-- Empty state, so a search that found nothing says so. -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                                           TextAlignment="Center"
                                           Text="No groups yet. Search above to find one." />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="Search results"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,8" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PrimarySmtpAddress}" Style="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Margin="0,4,0,0" Padding="8,2"
                                                    CornerRadius="{DynamicResource RadiusPill}"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource WarningSoftBrush}"
                                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                                    Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}">
                                                <TextBlock Text="Deleted in M365" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Nothing selected -->
                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding SelectedGroup, Converter={StaticResource NotNullToCollapsed}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                       Text="Select a group on the left to see its members and manage it." />
                        </StackPanel>
                    </Border>

                    <!-- Selected group -->
                    <Grid Grid.Column="2"
                          Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Identity header -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedGroup.DisplayName}" />
                                    <Border Margin="12,2,0,0" Padding="8,2" VerticalAlignment="Center"
                                            CornerRadius="{DynamicResource RadiusPill}"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedGroup.GroupTypeLabel}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <Border Margin="6,2,0,0" Padding="8,2" VerticalAlignment="Center"
                                            CornerRadius="{DynamicResource RadiusPill}"
                                            Background="{DynamicResource WarningSoftBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                            Visibility="{Binding SelectedGroup.StatusText, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="Deleted in M365" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="{Binding SelectedGroup.PrimarySmtpAddress}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           Text="{Binding OwnersText, StringFormat='Owners: {0}'}" />
                            </StackPanel>
                        </Border>

                        <!-- Ticket + requester apply to every action below -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.Name="Ticket or task number"
                                             Text="{Binding ManageTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.Name="Requester"
                                             Text="{Binding ManageRequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Gets the confirmation e-mail. Leave empty to send none." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- One management task at a time -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <TabControl Style="{StaticResource TabStrip}" Margin="16,4,16,12">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
                                </TabControl.Resources>

                                <!-- Members -->
                                <TabItem Header="Members">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource ModernTextBox}" Width="240"
                                                     AutomationProperties.Name="New member"
                                                     Text="{Binding NewMemberAddress, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="_Add member" Style="{StaticResource PrimaryButton}"
                                                    Margin="{DynamicResource GapInline}"
                                                    Command="{Binding AddMemberCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                            <Button Content="Re_move selected" Style="{StaticResource DangerButton}"
                                                    Margin="{DynamicResource GapInline}"
                                                    Command="{Binding RemoveMemberCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                            <Button Content="S_ync" Style="{StaticResource GhostButtonSmall}"
                                                    Margin="16,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="Re-fetch direct members live from Exchange and refresh the cache"
                                                    Command="{Binding SyncMembersCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                            <Button Content="_Excel" Style="{StaticResource GhostButtonSmall}"
                                                    Margin="{DynamicResource GapInline}" VerticalAlignment="Center"
                                                    Command="{Binding ExportToExcelCommand}" />
                                            <Button Content="CS_V" Style="{StaticResource GhostButtonSmall}"
                                                    Margin="{DynamicResource GapInline}" VerticalAlignment="Center"
                                                    Command="{Binding ExportToCsvCommand}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource ModernTextBox}" Width="280"
                                                     HorizontalAlignment="Left"
                                                     AutomationProperties.Name="Filter members"
                                                     Text="{Binding MemberFilterText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}"
                                                       Text="Filters by name, address, UPN, type or path. Add several members at once by separating them with commas; Ctrl+click rows to remove several." />
                                        </StackPanel>

                                        <DataGrid Grid.Row="2" x:Name="MembersDataGrid"
                                                  Style="{StaticResource ModernDataGrid}"
                                                  ItemsSource="{Binding MembersView}"
                                                  SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                                  SelectionChanged="MembersDataGrid_SelectionChanged"
                                                  SelectionMode="Extended" MinHeight="180"
                                                  AutomationProperties.Name="Group members">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Member" Width="*" Binding="{Binding DisplayName}" />
                                                <DataGridTextColumn Header="Address" Width="200" Binding="{Binding PrimarySmtpAddress}" />
                                                <DataGridTextColumn Header="Type" Width="120" Binding="{Binding RecipientType}" />
                                                <DataGridCheckBoxColumn Header="Nested" Width="70" Binding="{Binding IsNested}" />
                                                <DataGridTextColumn Header="Path" Width="180" Binding="{Binding Path}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Owners & senders -->
                                <TabItem Header="Owners &amp; senders">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource H3}" Text="Owners" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                       Text="{Binding OwnersText, StringFormat='Current: {0}'}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ComboBox AutomationProperties.Name="Owner change mode" Style="{StaticResource ModernComboBox}" Width="120"
                                                          ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding OwnerChangeMode}" />
                                                <TextBox AutomationProperties.Name="Owner identities" Style="{StaticResource ModernTextBox}" Width="380"
                                                         Margin="{DynamicResource GapInline}"
                                                         Text="{Binding OwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12"
                                                       Text="Comma-separated SamAccountName, UPN or e-mail address." />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                <Button Style="{StaticResource PrimaryButton}" Content="App_ly owner change"
                                                        Command="{Binding ChangeOwnersCommand}"
                                                        IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="Refresh _MailTip"
                                                        Margin="{DynamicResource GapInline}"
                                                        ToolTip="Rebuilds the MailTip from the current owners. Repairs one that still shows raw directory values."
                                                        Command="{Binding RefreshMailTipCommand}"
                                                        IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                            </StackPanel>

                                            <Border Style="{StaticResource Separator}" Margin="0,0,0,20" />

                                            <TextBlock Style="{StaticResource H3}" Text="Authorized senders" Margin="0,0,0,8" />
                                            <Border Style="{StaticResource Inset}" Padding="12" Margin="0,0,0,12">
                                                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding CurrentAuthorizedSenders}" />
                                                </ScrollViewer>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <ComboBox AutomationProperties.Name="Sender change mode" Style="{StaticResource ModernComboBox}" Width="120"
                                                          ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding SenderChangeMode}" />
                                                <TextBox AutomationProperties.Name="Authorized sender identities" Style="{StaticResource ModernTextBox}" Width="380"
                                                         Margin="{DynamicResource GapInline}"
                                                         Text="{Binding SenderIdentities, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource SecondaryButton}" Content="App_ly sender change"
                                                    HorizontalAlignment="Left" Margin="0,0,0,16"
                                                    Command="{Binding ChangeAuthorizedSendersCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Addresses -->
                                <TabItem Header="Addresses">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource H3}" Text="E-mail aliases" Margin="0,0,0,8" />
                                            <Border Style="{StaticResource Inset}" Padding="12" Margin="0,0,0,12">
                                                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding CurrentAliases}" />
                                                </ScrollViewer>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ComboBox AutomationProperties.Name="Alias change mode" Style="{StaticResource ModernComboBox}" Width="120"
                                                          ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding AliasChangeMode}" />
                                                <TextBox AutomationProperties.Name="Alias addresses" Style="{StaticResource ModernTextBox}" Width="380"
                                                         Margin="{DynamicResource GapInline}"
                                                         Text="{Binding AliasIdentities, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12"
                                                       Text="Full SMTP addresses, comma-separated. Replace is rejected here - it would drop the primary address." />
                                            <Button Style="{StaticResource SecondaryButton}" Content="App_ly alias change"
                                                    HorizontalAlignment="Left" Margin="0,0,0,24"
                                                    Command="{Binding ChangeAliasesCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />

                                            <Border Style="{StaticResource Separator}" Margin="0,0,0,20" />

                                            <TextBlock Style="{StaticResource H3}" Text="Rename" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                       Text="The previous address is kept as an alias, so mail sent to it keeps arriving." />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
                                            <TextBox AutomationProperties.Name="New name" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RenameNewName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="New primary address" />
                                            <TextBox AutomationProperties.Name="New primary address" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RenameNewAddress, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="_Rename group"
                                                    HorizontalAlignment="Left" Margin="0,0,0,16"
                                                    Command="{Binding RenameGroupCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Danger zone -->
                                <TabItem Header="Danger zone">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource H3}" Text="Replace membership" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                       Text="Sets the membership to exactly this list. Everyone not named here is removed. The previous membership is written to the log first." />
                                            <TextBox AutomationProperties.Name="Replacement member list" Style="{StaticResource ModernTextBoxMultiline}" Height="80"
                                                     Margin="0,0,0,12"
                                                     Text="{Binding ReplaceMembersText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Style="{StaticResource DangerButton}" Content="Re_place membership"
                                                    HorizontalAlignment="Left" Margin="0,0,0,24"
                                                    Command="{Binding ReplaceMembersCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />

                                            <Border Style="{StaticResource Separator}" Margin="0,0,0,20" />

                                            <TextBlock Style="{StaticResource H3}" Text="Delete group" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                       Text="Members, owners, aliases and settings are written to the log before anything is deleted. The right cmdlet is picked from the group's type. You are asked to confirm." />
                                            <Button Style="{StaticResource DangerButton}" Content="_Delete group"
                                                    HorizontalAlignment="Left" Margin="0,0,0,16"
                                                    Command="{Binding RemoveGroupCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Outcome, right where the work happens -->
                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                                 Visibility="{Binding IsManageBusy, Converter={StaticResource BoolToVisible}}" />
                    <controls:AlertBox Text="{Binding ManageStatusMessage}" Severity="{Binding ManageStatusSeverity}"
                                       Margin="0,0,0,12" />
                    <controls:AlertBox Text="{Binding StatusMessage}" Severity="{Binding StatusSeverity}" />

                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ================================================================
             Create group
             ================================================================ -->
        <TabItem Header="Create group">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,32" MaxWidth="{StaticResource ContentWidth}" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Creates a distribution list, a mail-enabled security group, or a dynamic distribution group. The name follows the dot convention (LST.EMEA.Some Team); the derived name and address are shown below and can be corrected before creating." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                                 Visibility="{Binding IsCreateBusy, Converter={StaticResource BoolToVisible}}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="{DynamicResource GapField}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                    <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CreateTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                                    <TextBox AutomationProperties.Name="Requester (optional)" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CreateRequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Gets the confirmation e-mail. Leave empty to send none." />
                                </StackPanel>
                            </Grid>

                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="{DynamicResource GapField}"
                                      Content="Dynamic distribution group (membership from a filter instead of a member list)"
                                      IsChecked="{Binding CreateIsDynamic}" />

                            <StackPanel Visibility="{Binding IsStaticCreate, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                                <ComboBox AutomationProperties.Name="Type" Style="{StaticResource ModernComboBox}" Margin="{DynamicResource GapField}"
                                          Width="200" HorizontalAlignment="Left"
                                          ItemsSource="{Binding GroupKinds}" SelectedItem="{Binding CreateKind}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Group name" />
                            <TextBox AutomationProperties.Name="Group name" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding CreateRawName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Prefix, location, then the name - e.g. &quot;LST.EMEA.Some Team Name&quot;." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Address domain" />
                            <TextBox AutomationProperties.Name="Address domain" Style="{StaticResource ModernTextBox}" Width="260" HorizontalAlignment="Left"
                                     Text="{Binding CreateDomain, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="e.g. ul.com - or ul.org for not-for-profit groups." />

                            <!-- Static-only fields -->
                            <StackPanel Visibility="{Binding IsStaticCreate, Converter={StaticResource BoolToVisible}}">
                                <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"
                                          Content="Temporary group (inserts TMP into the name)"
                                          IsChecked="{Binding CreateIsTemporary}" />
                                <StackPanel Orientation="Horizontal" Margin="{DynamicResource GapField}"
                                            Visibility="{Binding CreateIsTemporary, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Remove on"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <DatePicker AutomationProperties.Name="Remove on" SelectedDate="{Binding CreateRemoveOn}" Width="150"
                                                FontFamily="{DynamicResource FontFamilyUi}" FontSize="13" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Owner(s)" />
                                <TextBox AutomationProperties.Name="Owner(s)" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CreateOwners, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Comma-separated SamAccountName, UPN or e-mail." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Members" />
                                <TextBox AutomationProperties.Name="Members" Style="{StaticResource ModernTextBoxMultiline}" Height="70"
                                         Text="{Binding CreateMembers, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Comma- or line-separated. Other lists can be referenced by name (LST.*, DST.*, DSG.*)." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Authorized senders" />
                                <TextBox AutomationProperties.Name="Authorized senders" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CreateAuthorizedSenders, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Leave empty to let anyone send to the group." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Additional aliases" />
                                <TextBox AutomationProperties.Name="Additional aliases" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CreateAdditionalAliases, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Extra SMTP addresses, comma-separated." />

                                <CheckBox Style="{StaticResource ModernCheckBox}" Margin="{DynamicResource GapField}"
                                          Content="Allow use by external senders"
                                          IsChecked="{Binding CreateAllowExternalSenders}" />

                                <Expander Header="Advanced" Foreground="{DynamicResource TextBrush}"
                                          Margin="{DynamicResource GapField}">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Remove character from the name" />
                                        <TextBox AutomationProperties.Name="Remove character from the name" Style="{StaticResource ModernTextBox}" Width="60" HorizontalAlignment="Left"
                                                 Text="{Binding CreateRemoveCharacter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="A single character, replaced with a space in the third name segment." />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Dynamic-only: the recipient filter -->
                            <StackPanel Visibility="{Binding CreateIsDynamic, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource H3}" Text="Membership filter" Margin="0,4,0,8" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Pre-filled with the values the old script used. Leave a condition empty to omit it - an empty one would match only recipients whose attribute is literally blank." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Included recipients" />
                                <TextBox AutomationProperties.Name="Included recipients" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                         Width="220" HorizontalAlignment="Left"
                                         Text="{Binding DynamicIncludedRecipients, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal" Margin="{DynamicResource GapField}">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Company" />
                                        <TextBox AutomationProperties.Name="Company" Style="{StaticResource ModernTextBox}" Width="130"
                                                 Text="{Binding DynamicCompany, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 1" />
                                        <TextBox AutomationProperties.Name="Attribute 1" Style="{StaticResource ModernTextBox}" Width="110"
                                                 Text="{Binding DynamicCustomAttribute1, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 2" />
                                        <TextBox AutomationProperties.Name="Attribute 2" Style="{StaticResource ModernTextBox}" Width="80"
                                                 Text="{Binding DynamicCustomAttribute2, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 3" />
                                        <TextBox AutomationProperties.Name="Attribute 3" Style="{StaticResource ModernTextBox}" Width="110"
                                                 Text="{Binding DynamicCustomAttribute3, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 8" />
                                        <TextBox AutomationProperties.Name="Attribute 8" Style="{StaticResource ModernTextBox}" Width="110"
                                                 Text="{Binding DynamicCustomAttribute8, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="MailTip" />
                                <TextBox AutomationProperties.Name="MailTip" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                         Text="{Binding DynamicMailTip, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" />
                                <TextBox AutomationProperties.Name="Notes" Style="{StaticResource ModernTextBoxMultiline}" Height="60"
                                         Margin="{DynamicResource GapField}"
                                         Text="{Binding DynamicNotes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Editable preview -->
                            <Border Style="{StaticResource Inset}" Margin="0,4,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Final name" />
                                    <TextBox AutomationProperties.Name="Final name" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                             Text="{Binding PreviewName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Final address" />
                                    <TextBox AutomationProperties.Name="Final address" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                             Text="{Binding PreviewAddress, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="Derived from the fields above. Edit them and they stop updating." />
                                        <Button Content="Re_set" Style="{StaticResource GhostButtonSmall}"
                                                Margin="{DynamicResource GapInline}"
                                                Command="{Binding ResetPreviewCommand}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Text="{Binding PreviewProblems}"
                                               Visibility="{Binding PreviewProblems, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryButton}" Content="_Create group"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CreateGroupCommand}"
                                    IsEnabled="{Binding IsCreateBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <controls:AlertBox Margin="0,16,0,0"
                                       Text="{Binding CreateStatusMessage}" Severity="{Binding CreateStatusSeverity}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>


