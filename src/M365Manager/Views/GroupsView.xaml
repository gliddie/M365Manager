<UserControl x:Class="M365Manager.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: create -->
            <RowDefinition Height="Auto" />  <!-- 1: connect -->
            <RowDefinition Height="Auto" />  <!-- 2: busy -->
            <RowDefinition Height="Auto" />  <!-- 3: search -->
            <RowDefinition Height="Auto" />  <!-- 4: results + members -->
            <RowDefinition Height="Auto" />  <!-- 5: manage -->
            <RowDefinition Height="Auto" />  <!-- 6: status -->
            <RowDefinition Height="Auto" />  <!-- 7: console -->
        </Grid.RowDefinitions>

        <!-- ============ Create group ============ -->
        <Expander Grid.Row="0" Margin="0,0,0,18" IsExpanded="False"
                  Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
            <Expander.Header>
                <TextBlock Text="Create group" FontFamily="Segoe UI" FontSize="15"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            </Expander.Header>

            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                           Text="Creates a distribution list, a mail-enabled security group, or a dynamic distribution group. The name follows the dot convention (LST.EMEA.Some Team); the derived name and address are shown below and can be corrected before creating." />

                <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,14"
                             Visibility="{Binding IsCreateBusy, Converter={StaticResource BoolToVisible}}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding CreateTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                 Text="{Binding CreateRequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="SamAccountName, UPN or e-mail address. Gets the confirmation e-mail naming the group, its address and its owners. Leave empty to send no mail." />

                        <CheckBox Content="Dynamic distribution group (membership from a filter instead of a member list)"
                                  Margin="0,0,0,12" FontFamily="Segoe UI" FontSize="13"
                                  Foreground="{StaticResource TextBrush}"
                                  IsChecked="{Binding CreateIsDynamic}" />

                        <StackPanel Visibility="{Binding IsStaticCreate, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                            <ComboBox Margin="0,0,0,12" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding GroupKinds}" SelectedItem="{Binding CreateKind}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Group name" />
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                 Text="{Binding CreateRawName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="Prefix, location, then the name - e.g. &quot;LST.EMEA.Some Team Name&quot;." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Address domain" />
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4" Width="260"
                                 HorizontalAlignment="Left"
                                 Text="{Binding CreateDomain, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="e.g. ul.com - or ul.org for not-for-profit groups." />

                        <StackPanel Visibility="{Binding IsStaticCreate, Converter={StaticResource BoolToVisible}}">
                            <CheckBox Content="Temporary group (inserts TMP into the name)" Margin="0,0,0,8"
                                      FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                                      IsChecked="{Binding CreateIsTemporary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                        Visibility="{Binding CreateIsTemporary, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Remove on"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <DatePicker SelectedDate="{Binding CreateRemoveOn}" Width="140"
                                            FontFamily="Segoe UI" FontSize="13" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Owner(s)" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                     Text="{Binding CreateOwners, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Text="Comma-separated SamAccountName, UPN or e-mail." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Members" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CreateMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                       Text="Comma- or line-separated. Other lists can be referenced by name (LST.*, DST.*, DSG.*)." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Authorized senders" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                     Text="{Binding CreateAuthorizedSenders, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                       Text="Leave empty to let anyone send to the group." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Additional aliases" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                                     Text="{Binding CreateAdditionalAliases, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Text="Extra SMTP addresses, comma-separated." />

                            <CheckBox Content="Allow use by external senders" Margin="0,0,0,12"
                                      FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                                      IsChecked="{Binding CreateAllowExternalSenders}" />

                            <Expander Header="Advanced" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Remove character from the name" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="60" HorizontalAlignment="Left"
                                             Text="{Binding CreateRemoveCharacter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="A single character, replaced with a space in the third name segment." />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- Dynamic-only: the recipient filter -->
                        <StackPanel Visibility="{Binding CreateIsDynamic, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Membership filter" Margin="0,4,0,8" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                       Text="Pre-filled with the values the old script used. Leave a condition empty to omit it - an empty one would match only recipients whose attribute is literally blank." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Included recipients" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" Width="220" HorizontalAlignment="Left"
                                     Text="{Binding DynamicIncludedRecipients, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Company" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="130"
                                             Text="{Binding DynamicCompany, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 1" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="110"
                                             Text="{Binding DynamicCustomAttribute1, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 2" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                             Text="{Binding DynamicCustomAttribute2, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 3" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="110"
                                             Text="{Binding DynamicCustomAttribute3, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Attribute 8" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="110"
                                             Text="{Binding DynamicCustomAttribute8, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="MailTip" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                     Text="{Binding DynamicMailTip, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                     Text="{Binding DynamicNotes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Editable preview -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Final name" />
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                         Text="{Binding PreviewName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Final address" />
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                         Text="{Binding PreviewAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Text="Derived from the fields above. Edit them and they stop updating." />
                                    <Button Content="Reset" Style="{StaticResource SecondaryButtonSmall}" Margin="10,0,0,0"
                                            Command="{Binding ResetPreviewCommand}" />
                                </StackPanel>

                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#C0392B" Text="{Binding PreviewProblems}"
                                           Visibility="{Binding PreviewProblems, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Content="Create" HorizontalAlignment="Left"
                                Command="{Binding CreateGroupCommand}"
                                IsEnabled="{Binding IsCreateBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding CreateStatusMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Expander>

        <!-- Manual connect, only while Exchange is not connected. The app connects every service at
             startup, so this is the fallback for when that failed - hiding it the rest of the time
             keeps the page from inviting a reconnect that isn't needed. Collapsing the whole panel
             (not just the button) also drops its bottom margin. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToCollapsed}}">
            <Button Style="{StaticResource SecondaryButton}" Content="Connect to Exchange"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>

        <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}" Margin="0,0,0,14"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <!-- Device-code sign-in banner (shown only while a code is pending) -->
            <Border Margin="0,0,0,12" CornerRadius="8" Padding="18,14"
                    Background="{StaticResource UlRedSoftBrush}" BorderBrush="{StaticResource UlRedBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DeviceCodeMessage, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="Sign-in required" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource UlRedDarkBrush}" Margin="0,0,0,6" />

                    <!-- The code + copy button -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8"
                                Visibility="{Binding DeviceCode, Converter={StaticResource EmptyToCollapsed}}">
                        <Border Background="White" BorderBrush="{StaticResource UlRedBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource UlRedDarkBrush}" />
                        </Border>
                        <Button Content="Copy code" Style="{StaticResource SecondaryButtonSmall}"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CopyCodeCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding DeviceCodeMessage}" FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="A browser opens automatically. Paste the code, then sign in with your admin account."
                               Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource PrimaryButton}" Content="Search" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Clear" Margin="10,0,0,0"
                        Command="{Binding ClearResultsCommand}" />
            </StackPanel>

            <!-- Below the row rather than under the box: the row is horizontal. -->
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Group name, alias or e-mail address. Press Enter to search." />
        </StackPanel>

        <!-- Results + details. Fixed height: the page scrolls as a whole now, so this block must
             not try to grow into space it no longer has. -->
        <Grid Grid.Row="4" Height="520">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Results list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeletedInM365}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource UlRedSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,6">
                                <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PrimarySmtpAddress}" FontFamily="Segoe UI"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}" FontFamily="Segoe UI"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource UlRedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Margin="0,4,0,0" Padding="6,2" CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource UlRedSoftBrush}"
                                        BorderBrush="{StaticResource UlRedBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="Deleted in M365" FontFamily="Segoe UI"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource UlRedDarkBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Details + members -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedGroup.DisplayName}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,4"
                                   Text="{Binding SelectedGroup.PrimarySmtpAddress}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="{Binding SelectedGroup.StatusText}" Foreground="{StaticResource UlRedBrush}" FontWeight="SemiBold" />
                        <Border Margin="0,0,0,12" Padding="7,4" CornerRadius="8"
                                HorizontalAlignment="Left"
                                Background="{StaticResource UlRedSoftBrush}"
                                BorderBrush="{StaticResource UlRedBrush}"
                                BorderThickness="1"
                                Visibility="{Binding SelectedGroup.StatusText, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="Deleted in M365" FontFamily="Segoe UI"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource UlRedDarkBrush}" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="Type" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.GroupTypeLabel}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="Alias" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.Alias}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text="Owner(s)" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding OwnersText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Muted}" Text="Notes" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.Notes}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ServiceNow task number - required before any add/remove -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,0">
                            <TextBlock Text="ServiceNow task#" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="160"
                                     Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Member actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,0">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="230"
                                     Text="{Binding NewMemberAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Add member" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding AddMemberCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding RemoveMemberCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Sync" Style="{StaticResource SecondaryButtonSmall}" Margin="20,0,0,0"
                                    ToolTip="Re-fetch direct members live from Exchange and refresh the cache"
                                    Command="{Binding SyncMembersCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Export Excel" Style="{StaticResource SecondaryButtonSmall}" Margin="8,0,0,0"
                                    Command="{Binding ExportToExcelCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Export CSV" Style="{StaticResource SecondaryButtonSmall}" Margin="6,0,0,0"
                                    Command="{Binding ExportToCsvCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>

                        <!-- How-to hint -->
                        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="14,6,14,0" TextWrapping="Wrap"
                                   Text="To add several members at once, separate SamAccountNames or email addresses with commas (e.g. jdoe, asmith). To remove several, Ctrl+click or Shift+click multiple rows below, then click 'Remove selected'." />

                        <!-- Member filter -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,10,14,0">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="280"
                                     Text="{Binding MemberFilterText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Filters the list below by name, address, UPN, type or path" Style="{StaticResource Muted}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid Grid.Row="4" x:Name="MembersDataGrid" Margin="0,10,0,0" ItemsSource="{Binding MembersView}"
                                  SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                  SelectionChanged="MembersDataGrid_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  ClipboardCopyMode="IncludeHeader">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNested}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Member" Width="*" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Header="Address" Width="200" Binding="{Binding PrimarySmtpAddress}" />
                                <DataGridTextColumn Header="UPN" Width="200" Binding="{Binding UserPrincipalName}" />
                                <DataGridTextColumn Header="Type" Width="120" Binding="{Binding RecipientType}" />
                                <DataGridCheckBoxColumn Header="Nested" Width="70" Binding="{Binding IsNested}" />
                                <DataGridTextColumn Header="Path" Width="220" Binding="{Binding Path}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Manage the selected group ============ -->
        <StackPanel Grid.Row="5" MaxWidth="760" HorizontalAlignment="Left" Margin="0,24,0,0"
                    Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">

            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4"
                       Text="{Binding SelectedGroup.DisplayName, StringFormat='Manage: {0}'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                       Text="Owners, authorized senders, aliases, membership, rename and removal. Every action is recorded in the log with the ticket number below." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,14"
                         Visibility="{Binding IsManageBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ManageTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Required for every action in this section." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ManageRequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="SamAccountName, UPN or e-mail address. Gets the confirmation e-mail for an owner change, a membership replacement, an authorized-sender change, a rename or a removal. Alias changes send no mail. Leave empty to send none at all." />
                </StackPanel>
            </Border>

            <!-- Owners -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Owners" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="{Binding OwnersText, StringFormat='Current: {0}'}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="120" ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding OwnerChangeMode}" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="400" Margin="10,0,0,0"
                                 Text="{Binding OwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,-4,0,10" TextWrapping="Wrap"
                               Text="Comma-separated SamAccountName, UPN or e-mail address." />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply"
                                Command="{Binding ChangeOwnersCommand}"
                                IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh MailTip" Margin="10,0,0,0"
                                Command="{Binding RefreshMailTipCommand}"
                                IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}"
                                ToolTip="Rebuilds the group's MailTip from its current owners, without changing anything else" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="The MailTip is rewritten automatically on every owner change. Use 'Refresh MailTip' to repair one that still shows raw directory values instead of names." />
                </StackPanel>
            </Border>

            <!-- Authorized senders -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Authorized senders" Margin="0,0,0,8" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding CurrentAuthorizedSenders}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="120" ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding SenderChangeMode}" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="400" Margin="10,0,0,0"
                                 Text="{Binding SenderIdentities, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}" Content="Apply" HorizontalAlignment="Left"
                            Command="{Binding ChangeAuthorizedSendersCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Aliases -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="E-mail aliases" Margin="0,0,0,8" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding CurrentAliases}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox Width="120" ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding AliasChangeMode}" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="400" Margin="10,0,0,0"
                                 Text="{Binding AliasIdentities, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Full SMTP addresses, comma-separated. Replace is rejected here - it would drop the primary address." />

                    <Button Style="{StaticResource PrimaryButton}" Content="Apply" HorizontalAlignment="Left"
                            Command="{Binding ChangeAliasesCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Replace membership -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Replace membership" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Sets the membership to exactly this list, given as comma- or line-separated identities. The previous members are written to the log first." />

                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ReplaceMembersText, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Yes, replace the entire membership" Margin="0,0,0,10"
                              FontFamily="Segoe UI" FontSize="13" Foreground="#C0392B"
                              IsChecked="{Binding ReplaceMembersConfirmed}" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Replace" HorizontalAlignment="Left"
                            Command="{Binding ReplaceMembersCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Rename -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Rename" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="The previous address is kept as an alias, so mail sent to it keeps arriving." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                             Text="{Binding RenameNewName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="New primary address" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                             Text="{Binding RenameNewAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Rename" HorizontalAlignment="Left"
                            Command="{Binding RenameGroupCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Remove -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Remove" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Members, owners, aliases and settings are written to the log before anything is deleted. The right cmdlet is picked from the group's type." />

                    <CheckBox Content="Yes, delete this group - this cannot be undone here" Margin="0,0,0,10"
                              FontFamily="Segoe UI" FontSize="13" Foreground="#C0392B"
                              IsChecked="{Binding RemoveConfirmed}" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Remove group" HorizontalAlignment="Left"
                            Command="{Binding RemoveGroupCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ManageStatusMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="6" Style="{StaticResource Muted}" Margin="0,12,0,0"
                   Text="{Binding StatusMessage}" />

        <!-- PowerShell console -->
        <controls:PowerShellConsole Grid.Row="7" Margin="0,20,0,0" MaxHeight="300"
                                    Transcript="{Binding Transcript}" />
    </Grid>
    </ScrollViewer>
</UserControl>
