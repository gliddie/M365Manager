<UserControl x:Class="M365Manager.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connect + search bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource SecondaryButton}" Content="Connect to Exchange"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <!-- Device-code sign-in banner (shown only while a code is pending) -->
            <Border Margin="0,0,0,12" CornerRadius="8" Padding="18,14"
                    Background="{StaticResource UlRedSoftBrush}" BorderBrush="{StaticResource UlRedBrush}"
                    BorderThickness="1"
                    Visibility="{Binding DeviceCodeMessage, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="Sign-in required" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource UlRedDarkBrush}" Margin="0,0,0,6" />

                    <!-- The code + copy button -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8"
                                Visibility="{Binding DeviceCode, Converter={StaticResource EmptyToCollapsed}}">
                        <Border Background="White" BorderBrush="{StaticResource UlRedBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource UlRedDarkBrush}" />
                        </Border>
                        <Button Content="Copy code" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CopyCodeCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding DeviceCodeMessage}" FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="A browser opens automatically. Paste the code, then sign in with your admin account."
                               Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Group name, alias or email address" />
                <Button Style="{StaticResource PrimaryButton}" Content="Search" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </StackPanel>

        <!-- Results + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Results list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,6">
                                <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PrimarySmtpAddress}" FontFamily="Segoe UI"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Details + members -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedGroup.DisplayName}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                                   Text="{Binding SelectedGroup.PrimarySmtpAddress}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="Type" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.RecipientTypeDetails}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="Alias" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.Alias}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text="Owner(s)" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding OwnersText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Muted}" Text="Notes" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedGroup.Notes}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Member actions -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="230"
                                     Text="{Binding NewMemberAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Member email or UPN" />
                            <Button Content="Add member" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding AddMemberCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding RemoveMemberCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Members}"
                                  SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Member" Width="*" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Header="Address" Width="240" Binding="{Binding PrimarySmtpAddress}" />
                                <DataGridTextColumn Header="Type" Width="140" Binding="{Binding RecipientType}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,12,0,0"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
