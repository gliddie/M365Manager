<UserControl x:Class="M365Manager.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Filter ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <!-- Row 1: free text + task -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- Each filter sits in its own vertical panel, so a hint can go under the box
                         without landing beside it the way it would in the horizontal row. -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Search" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="300"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Width="300"
                                   TextWrapping="Wrap"
                                   Text="Matches message, target, action or event code." />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Task #" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="150"
                                 Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Width="150"
                                   TextWrapping="Wrap"
                                   Text="Partial number is enough." />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="From (UTC)" />
                        <DatePicker Width="130" SelectedDate="{Binding FromDate}" FontFamily="Segoe UI" FontSize="13" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="To (UTC)" />
                        <DatePicker Width="130" SelectedDate="{Binding ToDate}" FontFamily="Segoe UI" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- Row 2: drop-downs -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                        <ComboBox Width="230" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Area" />
                        <ComboBox Width="150" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Action" />
                        <ComboBox Width="180" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Severity" />
                        <ComboBox Width="110" ItemsSource="{Binding Severities}" SelectedItem="{Binding SelectedSeverity}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Max rows" />
                        <ComboBox Width="90" ItemsSource="{Binding ResultLimits}" SelectedItem="{Binding MaxResults}" />
                    </StackPanel>
                </StackPanel>

                <!-- Row 3: actions -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="Apply filter"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Clear" Margin="10,0,0,0"
                            Command="{Binding ClearFilterCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Export Excel" Margin="10,0,0,0"
                            Command="{Binding ExportToExcelCommand}" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}" Margin="0,0,0,14"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

        <!-- ============ Grid ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="30" FontFamily="Segoe UI" FontSize="12"
                      Background="Transparent" BorderThickness="0"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Width="140"
                                        Binding="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                    <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity}" />
                    <DataGridTextColumn Header="Code" Width="60" Binding="{Binding EventCode}" />
                    <DataGridTextColumn Header="Area" Width="110" Binding="{Binding Area}" />
                    <DataGridTextColumn Header="Action" Width="140" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Target" Width="160" Binding="{Binding TargetObject}" />
                    <DataGridTextColumn Header="Task#" Width="90" Binding="{Binding TaskNumber}" />
                    <DataGridTextColumn Header="User" Width="180" Binding="{Binding UserUpn}" />
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="0,12,0,0"
                   Text="Filtering runs in SQL Server, so a date range reaches entries well beyond the rows currently shown. Export Excel writes exactly the filtered result." />
    </Grid>
</UserControl>
