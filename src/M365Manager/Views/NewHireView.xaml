<UserControl x:Class="M365Manager.Views.NewHireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M365Manager.ViewModels"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Base look of a pill in the step rail. Each pill then adds one trigger on its own IsStepN
             flag, which is all that distinguishes the active one. -->
        <Style x:Key="StepPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <!-- Label/value pairs on the review card. -->
        <Style x:Key="ReviewLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
        <Style x:Key="ReviewValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="880" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="New hire" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="Enables a new employee for Teams telephony: finds their account and site, hands out a free number from the site's DID ranges, writes it to on-premises AD so the Entra Connect sync agrees with Teams, then grants the site's voice policies." />

            <!-- ============ Step rail ============ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource UlRedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource UlRedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource StepText}" Text="1  Employee" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource UlRedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource UlRedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource StepText}" Text="2  Number" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource UlRedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource UlRedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource StepText}" Text="3  Review" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource UlRedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource UlRedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource StepText}" Text="4  Result" />
                </Border>
            </StackPanel>

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <!-- ============ Step 1: employee ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Who is being enabled?" Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Employee" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                                 Text="{Binding Identity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="SamAccountName, UPN or e-mail address" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Look up" Margin="10,0,0,0"
                                Command="{Binding LookUpCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Width="320" HorizontalAlignment="Left"
                             Margin="0,0,0,4"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Required. Recorded in the audit log and in the telephony database's run log." />

                    <!-- Only meaningful once an account has been found. -->
                    <StackPanel Visibility="{Binding EmployeeSummary, Converter={StaticResource EmptyToCollapsed}}">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                           Text="{Binding EmployeeSummary}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="{Binding LicenceSummary}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Site" />
                        <ComboBox Width="420" HorizontalAlignment="Left" Margin="0,0,0,4"
                                  ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  FontFamily="Segoe UI" FontSize="13" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Taken from the employee's AD office. Change it if that attribute is empty or wrong - the site decides which numbers are on offer and which voice policies get granted." />

                        <!-- A blocker stops the run; a warning does not. -->
                        <Border Background="#FEF2F2" BorderBrush="{StaticResource ErrorBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisible}}">
                            <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource ErrorBrush}" Text="{Binding Blocker}" />
                        </Border>

                        <Border Background="#FFFBEB" BorderBrush="#F59E0B"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisible}}">
                            <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"
                                       Foreground="#B45309" Text="{Binding Warnings}" />
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Content="Continue" HorizontalAlignment="Left"
                                Command="{Binding GoToNumberCommand}"
                                IsEnabled="{Binding CanContinueFromEmployee}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Step 2: number ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Pick a number" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Blocks are listed least-used first. Searching a block lists the numbers not already assigned to an endpoint or explicitly blocked, and proposes one at random." />

                    <DataGrid ItemsSource="{Binding DidRanges}"
                              SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                              MaxHeight="200" Margin="0,0,0,12"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                              Background="Transparent" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From" Width="140" Binding="{Binding DidStart}" />
                            <DataGridTextColumn Header="To" Width="140" Binding="{Binding DidEnd}" />
                            <DataGridTextColumn Header="Used %" Width="70" Binding="{Binding Utilization}" />
                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource PrimaryButton}" Content="Search free numbers"
                                Command="{Binding FindFreeNumbersCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding RangeSummary}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Number" />
                    <ComboBox Width="240" HorizontalAlignment="Left" Margin="0,0,0,16"
                              ItemsSource="{Binding FreeDids}"
                              SelectedItem="{Binding SelectedDid, Mode=TwoWay}"
                              FontFamily="Segoe UI" FontSize="13" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Continue"
                                Command="{Binding GoToReviewCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Back" Margin="10,0,0,0"
                                Command="{Binding BackCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Step 3: review ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Review" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                               Text="Nothing has been changed yet. Applying writes to Active Directory, Teams and the telephony database, and mails the employee." />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Employee" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewName}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Account" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewAccount}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Site" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewOffice}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Number" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ReviewValue}"
                                   FontWeight="SemiBold" Text="{Binding ReviewNumber}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="SIP address" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewSipAddress}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Policies" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewPolicies}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource ReviewLabel}" Text="Directory" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ReviewValue}" Text="{Binding ReviewAdStep}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Enable for telephony"
                                Command="{Binding ConfigureCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Back" Margin="10,0,0,0"
                                Command="{Binding BackCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Step 4: result ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="Result" Margin="0,0,0,10" />

                    <TextBlock FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource TextBrush}" Text="{Binding ResultHeadline}" />

                    <ItemsControl ItemsSource="{Binding ResultSteps}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NewHireStepViewModel}">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                               Text="{Binding Icon}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                               Text="{Binding Name}" />

                                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding TeamsState}" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="Next hire" HorizontalAlignment="Left"
                            Command="{Binding StartOverCommand}" />
                </StackPanel>
            </Border>

            <!-- ============ Status ============ -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>

            <!-- ============ Console ============ -->
            <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
