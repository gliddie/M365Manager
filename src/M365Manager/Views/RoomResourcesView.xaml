<UserControl x:Class="M365Manager.Views.RoomResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <!--
        Same shape as Groups: overview first, because a ticket names a room; creating on the second
        tab; and the three management actions as sub-tabs on the selected room so only one is on
        screen at a time. The twelve-column grid is cut to four, with the rest in the detail card.
    -->
    <TabControl Style="{StaticResource TabStrip}" Padding="0"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
        </TabControl.Resources>

        <TabItem Header="Find &amp; manage">
            <Grid Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                                 AutomationProperties.Name="Filter rooms and resources"
                                 Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="_Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding RefreshOverviewCommand}"
                                IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="_Export Excel" Style="{StaticResource GhostButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding ExportToExcelCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Filter by name, alias, address, site, location or group. Read from the SQL cache, not live from M365 - refreshed after every change made here." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                 Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- Proportional rather than a fixed 430: the four-column grid does not need
                         two thirds of a wide screen, and at 430 the manage tabs wrapped onto two
                         rows and the tab content got only what was left under two stacked cards.
                         The minimums together must fit a laptop: at 420 + 430 the right column
                         was cut off at its edge instead of shrinking (2026-10-19). -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                           Text="No rooms or resources in the cache. Check the SQL connection in Settings, or run the scheduled import." />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding RoomsView}"
                                      SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                      AutomationProperties.Name="Rooms and resources">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Width="2*" MinWidth="140" Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="Address" Width="2*" MinWidth="150" Binding="{Binding PrimarySmtpAddress}" />
                                    <DataGridTextColumn Header="Site" Width="54" Binding="{Binding SiteCode}" />
                                    <DataGridTextColumn Header="Cap." Width="54" Binding="{Binding Capacity}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding SelectedRoom, Converter={StaticResource NotNullToCollapsed}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                       Text="Select a room or resource to change its details, manage its groups, or remove it." />
                        </StackPanel>
                    </Border>

                    <!--
                        One scroll for the whole column. The two cards above the tabs are sized to
                        their content, and on a laptop screen they used up all the height - the
                        tabs got none and their buttons were unreachable, with no scrollbar
                        (2026-10-19). The tab pages therefore have no ScrollViewer of their own: a
                        nested one would swallow the mouse wheel. MinHeight = viewport keeps the
                        tab card stretched to the bottom on a screen that has the room.
                    -->
                    <ScrollViewer x:Name="ManageScroll" Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedRoom, Converter={StaticResource NullToCollapsed}}">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=ManageScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Carries the columns the grid no longer has room for. -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedRoom.DisplayName}" />
                                    <Border Margin="12,2,0,0" Padding="8,2" VerticalAlignment="Center"
                                            CornerRadius="{DynamicResource RadiusPill}"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedRoom.ResourceKind}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                                           Text="{Binding SelectedRoom.PrimarySmtpAddress}" />

                                <!-- Two label/value pairs per row: four rows instead of seven, so the
                                     manage tabs below keep their height. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Margin" Value="0,0,12,4" />
                                        </Style>
                                        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Margin" Value="0,0,16,4" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Location" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.Office}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Time zone" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.TimeZone}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Access" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.AccessModel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Policy" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.BookingPolicy}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Room list" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.RoomListName}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Delegates" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.DelegateGroup}" />

                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Users group" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource DetailValue}" Text="{Binding SelectedRoom.UsersGroup}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Ticket + requester apply to every action below; side by side to save height. -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.Name="Ticket or task number"
                                             Text="{Binding ManageTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                               Text="Required for every action below." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                                    <TextBox AutomationProperties.Name="Requester (optional)" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding ManageRequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                               Text="Gets the confirmation e-mail. Empty sends none." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <TabControl Style="{StaticResource TabStrip}" Margin="16,4,16,12"
                                        SelectedIndex="{Binding ManageTabIndex, Mode=TwoWay}">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
                                </TabControl.Resources>

                                <TabItem Header="Details">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Capacity" />
                                                    <TextBox AutomationProperties.Name="Capacity" Style="{StaticResource ModernTextBox}" Width="90"
                                                             Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                                       Text="Part of the address: a new capacity also changes the e-mail address, alias and sign-in name (UPN). You are asked to confirm." />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Time zone" />
                                            <TextBox AutomationProperties.Name="Time zone" Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding EditTimeZone, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                                       Text="Windows time zone id, e.g. W. Europe Standard Time." />

                                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"
                                                      Content="Also change the booking policy"
                                                      IsChecked="{Binding ChangeBookingPolicy}" />
                                            <ComboBox Style="{StaticResource ModernComboBox}" Width="200"
                                                      HorizontalAlignment="Left" Margin="{DynamicResource GapField}"
                                                      ItemsSource="{Binding Presets}" SelectedItem="{Binding EditPreset}"
                                                      IsEnabled="{Binding ChangeBookingPolicy}" />

                                            <Button Style="{StaticResource PrimaryButton}" Content="_Apply changes"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding UpdateDetailsCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Members">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource GapField}">
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Group" />
                                                    <ComboBox AutomationProperties.Name="Group" Style="{StaticResource ModernComboBox}" Width="140"
                                                              ItemsSource="{Binding GroupKinds}" SelectedItem="{Binding MembershipGroupKind}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Action" />
                                                    <ComboBox AutomationProperties.Name="Action" Style="{StaticResource ModernComboBox}" Width="120"
                                                              ItemsSource="{Binding MembershipModes}" SelectedItem="{Binding MembershipMode}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Current members" />
                                            <Border Style="{StaticResource Inset}" Padding="12" Margin="0,0,0,16">
                                                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding CurrentMembers}" />
                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Identities" />
                                            <TextBox AutomationProperties.Name="Identities" Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding MembershipIdentities, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                                       Text="Comma-separated SamAccountName, UPN, e-mail address or group name." />

                                            <Button Style="{StaticResource PrimaryButton}" Content="_Apply membership change"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding ChangeMembershipCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <!-- Index 2 - RoomResourcesViewModel.TelephonyTabIndex jumps here from the Create tab. -->
                                <TabItem Header="Telephony">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Margin="{DynamicResource GapField}"
                                                       Text="Gives the room a number from its site's blocks and the site's voice policies. Direct Routing: voice routing, dial plan and both emergency policies. Operator Connect: the dial plan only. The room needs a licence with Teams Phone (Teams Rooms Pro)." />

                                            <Button Style="{StaticResource SecondaryButton}" Content="_Look up room"
                                                    HorizontalAlignment="Left" Margin="{DynamicResource GapField}"
                                                    Command="{Binding LookUpTelephonyCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />

                                            <!-- Only meaningful once the room account has been read. -->
                                            <StackPanel Visibility="{Binding TelephonyAccountSummary, Converter={StaticResource EmptyToCollapsed}}">
                                                <Border Style="{StaticResource Inset}" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Body}" Text="{Binding TelephonyAccountSummary}" />
                                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                                   Text="{Binding TelephonyLicenceSummary}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- A blocker stops the run; a warning does not. -->
                                                <controls:AlertBox Margin="0,0,0,12" Text="{Binding TelephonyBlocker}" Severity="Error" />
                                                <controls:AlertBox Margin="0,0,0,12" Text="{Binding TelephonyWarnings}" Severity="Warning" />

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Site" />
                                                <ComboBox Style="{StaticResource ModernComboBox}"
                                                          AutomationProperties.Name="Site"
                                                          ItemsSource="{Binding TelephonyLocations}"
                                                          SelectedItem="{Binding SelectedTelephonyLocation, Mode=TwoWay}"
                                                          DisplayMemberPath="Label" />
                                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                           Text="Matched from the room's site code. Decides the number blocks, the policy names and the usage location (the site's country)." />

                                                <!-- Offered only when the room lacks Teams Phone and a Teams Rooms
                                                     licence is free; assigned only after the confirm dialog. -->
                                                <Border Style="{StaticResource Inset}" Margin="0,0,0,12"
                                                        Visibility="{Binding HasTelephonyLicenceOffer, Converter={StaticResource BoolToVisible}}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Licence" />
                                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                                   Text="{Binding TelephonyLicenceOffer.StockText}" />
                                                        <StackPanel IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}"
                                                                    HorizontalAlignment="Left">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Assign licen_ce"
                                                                    Command="{Binding AssignTelephonyLicenceCommand}"
                                                                    IsEnabled="{Binding CanAssignTelephonyLicence}" />
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                                                   Text="Asks for confirmation first. Sets the usage location to the site's country, which Entra needs before any licence." />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Number block" />
                                                <ComboBox Style="{StaticResource ModernComboBox}"
                                                          AutomationProperties.Name="Number block"
                                                          ItemsSource="{Binding TelephonyRanges}"
                                                          SelectedItem="{Binding SelectedTelephonyRange, Mode=TwoWay}"
                                                          DisplayMemberPath="Label"
                                                          IsEnabled="{Binding CanPickTelephonyNumber}" />
                                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                           Text="Least-used first. The block's type decides Direct Routing or Operator Connect." />

                                                <Button Style="{StaticResource SecondaryButton}" Content="Find _free numbers"
                                                        HorizontalAlignment="Left" Margin="0,0,0,12"
                                                        Command="{Binding FindTelephonyNumbersCommand}"
                                                        IsEnabled="{Binding CanPickTelephonyNumber}" />

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Number" />
                                                <ComboBox Style="{StaticResource ModernComboBox}" Width="240" HorizontalAlignment="Left"
                                                          Margin="{DynamicResource GapField}"
                                                          AutomationProperties.Name="Number"
                                                          ItemsSource="{Binding TelephonyFreeDids}"
                                                          SelectedItem="{Binding SelectedTelephonyDid, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanPickTelephonyNumber}" />

                                                <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                                        Visibility="{Binding TelephonyPlan, Converter={StaticResource EmptyToCollapsed}}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Will be set" />
                                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                                   Text="{Binding TelephonyPlan}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Two conditions: the panel is idle, and there is something to assign. -->
                                                <StackPanel IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}"
                                                            HorizontalAlignment="Left" Margin="0,0,0,12">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="_Assign number"
                                                            Command="{Binding AssignTelephonyNumberCommand}"
                                                            IsEnabled="{Binding CanAssignTelephonyNumber}" />
                                                </StackPanel>

                                                <controls:AlertBox Text="{Binding TelephonyResult}" Severity="{Binding TelephonyResultSeverity}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Account">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Margin="{DynamicResource GapField}"
                                                       Text="Enables the room account with a new random password that never expires, so a Teams Rooms device can sign in. Use it for a room whose account was never enabled, or when a device needs a new password - a device signed in with the old one is signed out." />

                                            <Button Style="{StaticResource DangerButton}" Content="Set _new password"
                                                    HorizontalAlignment="Left" Margin="0,0,0,16"
                                                    Command="{Binding SetNewAccountPasswordCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />

                                            <!-- Shown once, cleared when another room is selected. -->
                                            <Border Style="{StaticResource Inset}"
                                                    Visibility="{Binding HasManagePassword, Converter={StaticResource BoolToVisible}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,16,8" Text="Display name" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                                             Margin="0,0,0,8" AutomationProperties.Name="Room display name"
                                                             Text="{Binding ManagePasswordDisplayName, Mode=OneWay}" />
                                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy na_me"
                                                            Margin="12,0,0,8" Command="{Binding CopyManageDisplayNameCommand}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,16,8" Text="Sign-in name (UPN)" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                                             Margin="0,0,0,8" AutomationProperties.Name="Room sign-in name"
                                                             Text="{Binding ManagePasswordUpn, Mode=OneWay}" />
                                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy U_PN"
                                                            Margin="12,0,0,8" Command="{Binding CopyManageUpnCommand}" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,16,0" Text="Password" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                                             FontFamily="Consolas" AutomationProperties.Name="Room account password"
                                                             Text="{Binding ManagePassword, Mode=OneWay}" />
                                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy pass_word"
                                                            Margin="12,0,0,0" Command="{Binding CopyManagePasswordCommand}" />

                                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                                                               Text="Shown only now - not stored, logged or mailed. Cleared when you select another room." />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Rename">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
                                            <TextBox AutomationProperties.Name="New name" Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding RenameRawName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                       Text="&lt;SITE&gt; &lt;Name&gt;, e.g. FRK Meeting Room 2. A new site code moves the room to that site's room list, delegates, admins and time zone." />

                                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource GapField}">
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Building" />
                                                    <TextBox AutomationProperties.Name="New building" Style="{StaticResource ModernTextBox}" Width="100"
                                                             Text="{Binding RenameBuilding, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Floor" />
                                                    <TextBox AutomationProperties.Name="New floor" Style="{StaticResource ModernTextBox}" Width="80"
                                                             Text="{Binding RenameFloor, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Capacity" />
                                                    <TextBox AutomationProperties.Name="New capacity" Style="{StaticResource ModernTextBox}" Width="80"
                                                             Text="{Binding RenameCapacity, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Style="{StaticResource SecondaryButton}" Content="_Preview rename"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                                    Command="{Binding PreviewRenameCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />

                                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                                    Visibility="{Binding RenamePlanSummary, Converter={StaticResource EmptyToCollapsed}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Will change" />
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                               Text="{Binding RenamePlanSummary}" />
                                                </StackPanel>
                                            </Border>

                                            <Button Style="{StaticResource DangerButton}" Content="Re_name room"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding RenameRoomCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                                                       Text="The old address stays as an alias, and the sign-in name (UPN) moves with it. The requester above gets a confirmation e-mail." />
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Danger zone">
                                    <Border Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H3}" Text="Delete room / resource" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                                       Text="A full snapshot - mailbox, statistics, permissions, calendar processing and configuration - is written to the log before anything is deleted. You are asked to confirm." />

                                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"
                                                      Content="Also delete this room's own delegate/users groups and drop it from its room list"
                                                      IsChecked="{Binding RemoveOrphanedGroups}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16"
                                                       Text="Shared site-wide delegate groups are never deleted - only groups belonging to this room alone." />

                                            <Button Style="{StaticResource DangerButton}" Content="_Delete room / resource"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding RemoveCommand}"
                                                    IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                                 Visibility="{Binding IsManageBusy, Converter={StaticResource BoolToVisible}}" />
                    <controls:AlertBox Text="{Binding ManageStatusMessage}" Severity="{Binding ManageStatusSeverity}"
                                       Margin="0,0,0,12" />
                    <controls:AlertBox Text="{Binding OverviewStatusMessage}" Severity="{Binding OverviewStatusSeverity}" />
                </StackPanel>

            </Grid>
        </TabItem>

        <TabItem Header="Create room or resource">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,32" MaxWidth="{StaticResource ContentWidth}" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Creates a conference room or equipment mailbox with its room list, delegate group and (for restricted rooms) authorized-users group, calendar booking policy, permissions and time zone - in one step, with a preview of what will be created." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="{DynamicResource GapField}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                    <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                                    <TextBox AutomationProperties.Name="Requester (optional)" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding RequesterIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Gets the confirmation e-mail. Leave empty to send none." />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                            <ComboBox AutomationProperties.Name="Type" Style="{StaticResource ModernComboBox}" Margin="{DynamicResource GapField}"
                                      Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding ResourceKinds}" SelectedItem="{Binding Kind}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                            <TextBox AutomationProperties.Name="Name" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RawName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Start with the three-letter site code, then the room name - e.g. &quot;NBK Meeting Room 1&quot;." />

                            <!-- Decided up front, each on its own: a Teams Rooms licence and a phone
                                 number. Both run in the same Create, and the requester gets one mail
                                 once all of it is done. Rooms only. -->
                            <StackPanel Visibility="{Binding IsRoom, Converter={StaticResource BoolToVisible}}">
                                <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,4"
                                          Content="Assign a Teams Rooms Pro licence"
                                          AutomationProperties.Name="Assign a Teams Rooms Pro licence"
                                          IsChecked="{Binding CreateAssignLicence}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="24,0,0,8"
                                           Text="{Binding CreateLicenceText}"
                                           Visibility="{Binding CreateLicenceText, Converter={StaticResource EmptyToCollapsed}}" />

                                <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,4,0,8"
                                          Content="Set up Teams telephony - the room gets a phone number"
                                          AutomationProperties.Name="Set up Teams telephony"
                                          IsChecked="{Binding CreateWithTelephony}" />

                                <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                        Visibility="{Binding ShowCreateSite, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Site" />
                                        <ComboBox Style="{StaticResource ModernComboBox}" Width="420" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Site for licence and telephony"
                                                  ItemsSource="{Binding TelephonyLocations}"
                                                  SelectedItem="{Binding CreateTelephonyLocation, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                   Text="Matched from the name's site code. Its country becomes the usage location (needed for the licence); for telephony it also decides the number blocks and policy names." />

                                        <controls:AlertBox Margin="0,0,0,12" Text="{Binding CreateTelephonySiteProblem}" Severity="Error" />

                                        <StackPanel Visibility="{Binding CreateWithTelephony, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Number block" />
                                            <ComboBox Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Number block"
                                                      ItemsSource="{Binding CreateTelephonyRanges}"
                                                      SelectedItem="{Binding CreateTelephonyRange, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding CanPickCreateNumber}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                       Text="Least-used first. The block's type decides Direct Routing (four policies) or Operator Connect (dial plan only)." />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Find _free numbers"
                                                        Command="{Binding FindCreateTelephonyNumbersCommand}"
                                                        IsEnabled="{Binding CanPickCreateNumber}" />
                                                <ComboBox Style="{StaticResource ModernComboBox}" Width="240"
                                                          Margin="{DynamicResource GapInline}"
                                                          AutomationProperties.Name="Phone number"
                                                          ItemsSource="{Binding CreateTelephonyFreeDids}"
                                                          SelectedItem="{Binding CreateTelephonyDid, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanPickCreateNumber}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="{Binding CreateTelephonyPlan}"
                                                   Visibility="{Binding CreateTelephonyPlan, Converter={StaticResource EmptyToCollapsed}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRoom, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Building" />
                                        <TextBox AutomationProperties.Name="Building" Style="{StaticResource ModernTextBox}" Width="140"
                                                 Text="{Binding Building, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Floor" />
                                        <TextBox AutomationProperties.Name="Floor" Style="{StaticResource ModernTextBox}" Width="90"
                                                 Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Capacity" />
                                        <TextBox AutomationProperties.Name="Capacity" Style="{StaticResource ModernTextBox}" Width="90"
                                                 Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Floor: a number, or 0 / Ground for the ground floor." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Access model" />
                            <ComboBox AutomationProperties.Name="Access model" Style="{StaticResource ModernComboBox}" Width="320" HorizontalAlignment="Left"
                                      ItemsSource="{Binding AccessModels}" SelectedItem="{Binding AccessModel}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="GeneralUseSiteDelegates: anyone books, the shared site delegate group approves out-of-policy. GeneralUseCustomDelegates: same, but with its own delegate group. Restricted: only members of the room's users group may book." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Booking policy" />
                            <ComboBox AutomationProperties.Name="Booking policy" Style="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Standard: recurring meetings allowed, limited conflicts. Hoteling: no recurring meetings, no conflicts. Custom: set the values yourself below." />

                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource GapField}"
                                        Visibility="{Binding IsCustomPolicy, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Window (days)" />
                                    <TextBox AutomationProperties.Name="Window (days)" Style="{StaticResource ModernTextBox}" Width="110"
                                             Text="{Binding CustomBookingWindowDays, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Max duration (min)" />
                                    <TextBox AutomationProperties.Name="Max duration (min)" Style="{StaticResource ModernTextBox}" Width="130"
                                             Text="{Binding CustomMaxDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernCheckBox}" VerticalAlignment="Bottom"
                                          Margin="0,0,0,8" Content="Allow recurring meetings"
                                          IsChecked="{Binding CustomAllowRecurring}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Delegate group members" />
                            <TextBox AutomationProperties.Name="Delegate group members" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding DelegateMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Comma-separated identities. Approve out-of-policy requests and get FullAccess on the mailbox. Ignored when an existing group is reused." />

                            <StackPanel Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Authorized users" />
                                <TextBox AutomationProperties.Name="Authorized users" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding UserMembers, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                           Text="Comma-separated identities - only these may book a restricted room." />
                            </StackPanel>

                            <Expander Header="Domain overrides" Margin="{DynamicResource GapField}"
                                      Foreground="{DynamicResource TextBrush}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mailbox domain" />
                                    <TextBox AutomationProperties.Name="Mailbox domain" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding MailboxDomainOverride, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                               Text="Leave empty to use the configured room mailbox domain." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Group domain" />
                                    <TextBox AutomationProperties.Name="Group domain" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding GroupDomainOverride, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Leave empty to use the configured room group domain." />
                                </StackPanel>
                            </Expander>

                            <!-- Live preview of everything that will be created -->
                            <Border Style="{StaticResource Inset}" Margin="0,4,0,16"
                                    Visibility="{Binding PreviewDisplayName, Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Will be created as" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                               Text="{Binding PreviewDisplayName, StringFormat='Display name:  {0}'}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                               Text="{Binding PreviewAddress, StringFormat='Address:  {0}'}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                               Text="{Binding PreviewSiteInfo, StringFormat='Site:  {0}'}"
                                               Visibility="{Binding PreviewSiteInfo, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                               Text="{Binding PreviewRoomList, StringFormat='Room list:  {0}'}"
                                               Visibility="{Binding PreviewRoomList, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                               Text="{Binding PreviewDelegateGroup, StringFormat='Delegate group:  {0}'}" />
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="{Binding PreviewUsersGroup, StringFormat='Users group:  {0}'}"
                                               Visibility="{Binding PreviewUsersGroup, Converter={StaticResource EmptyToCollapsed}}" />

                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Text="{Binding PreviewProblems}"
                                               Visibility="{Binding PreviewProblems, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryButton}" Content="_Create room or resource"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CreateCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <controls:AlertBox Margin="0,16,0,0"
                                       Text="{Binding StatusMessage}" Severity="{Binding StatusSeverity}" />

                    <controls:AlertBox Margin="0,12,0,0"
                                       Text="{Binding CreateTelephonyResult}" Severity="{Binding CreateTelephonyResultSeverity}" />

                    <!-- The room account's password: shown once, to copy into the Teams Rooms device
                         setup. Not stored, not logged, not mailed - the requester is told to ask. -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding HasCreatedAccountCard, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Room account" Margin="0,0,0,12" />

                            <!-- Label, read-only value (selectable for Ctrl+C), copy button - one row each.
                                 The number and password rows only show when there is one. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,16,8" Text="Display name" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Room display name"
                                         Text="{Binding CreatedDisplayName, Mode=OneWay}" />
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy na_me"
                                        Margin="12,0,0,8"
                                        Command="{Binding CopyCreatedDisplayNameCommand}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,16,8" Text="Sign-in name (UPN)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Room sign-in name"
                                         Text="{Binding CreatedAccountUpn, Mode=OneWay}" />
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy U_PN"
                                        Margin="12,0,0,8"
                                        Command="{Binding CopyCreatedUpnCommand}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,16,8" Text="Phone number"
                                           Visibility="{Binding CreatedPhoneNumber, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Room phone number"
                                         Text="{Binding CreatedPhoneNumber, Mode=OneWay}"
                                         Visibility="{Binding CreatedPhoneNumber, Converter={StaticResource EmptyToCollapsed}}" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy num_ber"
                                        Margin="12,0,0,8"
                                        Command="{Binding CopyCreatedPhoneNumberCommand}"
                                        Visibility="{Binding CreatedPhoneNumber, Converter={StaticResource EmptyToCollapsed}}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,16,0" Text="Password"
                                           Visibility="{Binding HasCreatedPassword, Converter={StaticResource BoolToVisible}}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                         FontFamily="Consolas"
                                         AutomationProperties.Name="Room account password"
                                         Text="{Binding CreatedPassword, Mode=OneWay}"
                                         Visibility="{Binding HasCreatedPassword, Converter={StaticResource BoolToVisible}}" />
                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy pass_word"
                                        Margin="12,0,0,0"
                                        Command="{Binding CopyCreatedPasswordCommand}"
                                        Visibility="{Binding HasCreatedPassword, Converter={StaticResource BoolToVisible}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                       Visibility="{Binding HasCreatedPassword, Converter={StaticResource BoolToVisible}}"
                                       Text="The password never expires. Shown only now - it is not stored anywhere. The requester's e-mail asks them to contact you for it." />
                        </StackPanel>
                    </Border>

                    <!-- A new room has no licence yet, so telephony cannot run as part of Create;
                         this opens the room on its Telephony tab once it is licensed. -->
                    <Button Style="{StaticResource GhostButton}" Content="Set up _telephony for this room"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding SetUpTelephonyForCreatedRoomCommand}"
                            Visibility="{Binding HasLastCreatedRoom, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

