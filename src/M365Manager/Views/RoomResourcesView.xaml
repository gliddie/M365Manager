<UserControl x:Class="M365Manager.Views.RoomResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="1000" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="Create Room / Resource" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Creates a conference room or equipment mailbox with its room list, delegate group and (for restricted rooms) authorized-users group, calendar booking policy, permissions and time zone - everything the old Room &amp; Resource Admin Menu did, in one step and with a preview of what will be created." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Required - authorizes this creation, e.g. TASK0012345" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding RequesterIdentity, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="SamAccountName, UPN or e-mail address" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Gets the confirmation e-mail describing the room, its delegates and the booking policy. Leave empty to send no mail." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                    <ComboBox Margin="0,0,0,12" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding ResourceKinds}" SelectedItem="{Binding Kind}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding RawName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="&quot;&lt;SITE&gt; &lt;Name&gt;&quot; - the first word is the site code, e.g. &quot;NBK Meeting Room 1&quot;" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Start with the three-letter site code, then the room name - e.g. &quot;NBK Meeting Room 1&quot;." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding IsRoom, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Building" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="140" HorizontalAlignment="Left"
                                     Text="{Binding Building, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Floor" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="90" HorizontalAlignment="Left"
                                     Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Floor number, or 0 / Ground for the ground floor" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Capacity" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="90" HorizontalAlignment="Left"
                                     Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Access model" />
                    <ComboBox Margin="0,0,0,4" Width="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding AccessModels}" SelectedItem="{Binding AccessModel}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="GeneralUseSiteDelegates: anyone books, the shared site delegate group approves out-of-policy. GeneralUseCustomDelegates: same, but with its own delegate group. Restricted: only members of the room's users group may book." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Booking policy" />
                    <ComboBox Margin="0,0,0,4" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Standard: recurring meetings allowed, limited conflicts. Hoteling: no recurring meetings, no conflicts. Custom: set the values yourself below." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding IsCustomPolicy, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Window (days)" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="110" HorizontalAlignment="Left"
                                     Text="{Binding CustomBookingWindowDays, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Max duration (min)" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding CustomMaxDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="Allow recurring meetings" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                  FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                                  IsChecked="{Binding CustomAllowRecurring}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Delegate group members" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding DelegateMembers, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma-separated identities - only used when the delegate group is created here" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Approve out-of-policy requests and get FullAccess on the mailbox. Ignored when an existing group is reused." />

                    <StackPanel Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Authorized users" />
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding UserMembers, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Comma-separated identities - only these may book a restricted room" />
                    </StackPanel>

                    <Expander Header="Domain overrides" Margin="0,0,0,12" Foreground="{StaticResource TextBrush}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mailbox domain" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                                     Text="{Binding MailboxDomainOverride, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Leave empty to use the configured room mailbox domain" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Group domain" />
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding GroupDomainOverride, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Leave empty to use the configured room group domain" />
                        </StackPanel>
                    </Expander>

                    <Button Style="{StaticResource PrimaryButton}" Content="Create"
                            HorizontalAlignment="Left"
                            Command="{Binding CreateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- ============ Live preview ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding PreviewDisplayName, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Preview" FontSize="15" Margin="0,0,0,10" />

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewDisplayName, StringFormat='Display name:  {0}'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewAddress, StringFormat='Address:  {0}'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewOffice, StringFormat='Location:  {0}'}"
                               Visibility="{Binding PreviewOffice, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewSiteInfo, StringFormat='Site:  {0}'}"
                               Visibility="{Binding PreviewSiteInfo, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewRoomList, StringFormat='Room list:  {0}'}"
                               Visibility="{Binding PreviewRoomList, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewDelegateGroup, StringFormat='Delegate group:  {0}'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="{Binding PreviewUsersGroup, StringFormat='Users group:  {0}'}"
                               Visibility="{Binding PreviewUsersGroup, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#C0392B"
                               Text="{Binding PreviewProblems}"
                               Visibility="{Binding PreviewProblems, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- ============ Overview grid ============ -->
        <TextBlock Style="{StaticResource H2}" Text="Rooms &amp; resources overview" Margin="0,32,0,4" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Read directly from the SQL cache (dbo.RoomResources), never live from M365. Select a row to manage it below. Kept current by the scheduled Import-RoomResourcesToSql.ps1 script and refreshed after every change made here." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                     Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by name, alias, address, site, location or group" />
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding RefreshOverviewCommand}"
                    IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
            <Button Content="Export Excel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding ExportToExcelCommand}" />
        </StackPanel>

        <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                     Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding RoomsView}"
                      SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                      MaxHeight="420"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                      Background="Transparent" BorderThickness="0"
                      VerticalScrollBarVisibility="Auto"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="200" Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="Type" Width="80" Binding="{Binding ResourceKind}" />
                    <DataGridTextColumn Header="Address" Width="220" Binding="{Binding PrimarySmtpAddress}" />
                    <DataGridTextColumn Header="Cap." Width="55" Binding="{Binding Capacity}" />
                    <DataGridTextColumn Header="Site" Width="55" Binding="{Binding SiteCode}" />
                    <DataGridTextColumn Header="Location" Width="150" Binding="{Binding Office}" />
                    <DataGridTextColumn Header="Access" Width="150" Binding="{Binding AccessModel}" />
                    <DataGridTextColumn Header="Policy" Width="80" Binding="{Binding BookingPolicy}" />
                    <DataGridTextColumn Header="Room list" Width="170" Binding="{Binding RoomListName}" />
                    <DataGridTextColumn Header="Delegate group" Width="220" Binding="{Binding DelegateGroup}" />
                    <DataGridTextColumn Header="Users group" Width="220" Binding="{Binding UsersGroup}" />
                    <DataGridTextColumn Header="Time zone" Width="160" Binding="{Binding TimeZone}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding OverviewStatusMessage}" />

        <!-- ============ Manage selected ============ -->
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,32,0,0"
                    Visibility="{Binding SelectedRoom, Converter={StaticResource NullToCollapsed}}">

            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4"
                       Text="{Binding SelectedRoom.DisplayName, StringFormat='Manage: {0}'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Change details, manage the delegate/authorized-users groups, or remove this room. Every action is recorded in the log with the ticket number below." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsManageBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ManageTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Required for every action in this section." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Requester (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ManageRequesterIdentity, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="SamAccountName, UPN or e-mail address" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Gets a confirmation e-mail for a detail change, a removal, or users added to a restricted room. Leave empty to send no mail." />
                </StackPanel>
            </Border>

            <!-- Edit details -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Details" FontSize="15" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Capacity" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="90" HorizontalAlignment="Left"
                                     Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Building" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="140" HorizontalAlignment="Left"
                                     Text="{Binding EditBuilding, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Floor" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="90" HorizontalAlignment="Left"
                                     Text="{Binding EditFloor, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Time zone" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding EditTimeZone, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Windows time zone id, e.g. W. Europe Standard Time" />

                    <CheckBox Content="Also change the booking policy" Margin="0,0,0,8"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding ChangeBookingPolicy}" />
                    <ComboBox Margin="0,0,0,12" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding Presets}" SelectedItem="{Binding EditPreset}"
                              IsEnabled="{Binding ChangeBookingPolicy}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Apply changes"
                            HorizontalAlignment="Left"
                            Command="{Binding UpdateDetailsCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Membership -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Delegates &amp; authorized users" FontSize="15" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Group" />
                            <ComboBox Width="140" HorizontalAlignment="Left"
                                      ItemsSource="{Binding GroupKinds}" SelectedItem="{Binding MembershipGroupKind}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Action" />
                            <ComboBox Width="120" HorizontalAlignment="Left"
                                      ItemsSource="{Binding MembershipModes}" SelectedItem="{Binding MembershipMode}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Current members" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding CurrentMembers}" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Identities" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding MembershipIdentities, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma-separated SamAccountName, UPN, e-mail address or group name" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Apply membership change"
                            HorizontalAlignment="Left"
                            Command="{Binding ChangeMembershipCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Remove -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Remove" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="A full snapshot (mailbox, statistics, permissions, calendar processing and configuration) is written to the log before anything is deleted." />

                    <CheckBox Content="Also delete this room's own delegate/users groups and drop it from its room list"
                              Margin="0,0,0,8" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding RemoveOrphanedGroups}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Shared site-wide delegate groups are never deleted - only groups belonging to this room alone." />

                    <CheckBox Content="Yes, delete this mailbox - this cannot be undone here"
                              Margin="0,0,0,12" FontFamily="Segoe UI" FontSize="13" Foreground="#C0392B"
                              IsChecked="{Binding RemoveConfirmed}" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Remove room / resource"
                            HorizontalAlignment="Left"
                            Command="{Binding RemoveCommand}"
                            IsEnabled="{Binding IsManageBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ManageStatusMessage}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- ============ PowerShell console ============ -->
        <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
