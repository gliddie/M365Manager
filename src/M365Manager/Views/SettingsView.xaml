<UserControl x:Class="M365Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="720" HorizontalAlignment="Left">

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <!-- ============ SQL Server ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="SQL Server (logging)" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Where audit and activity logs are stored. Passwords are encrypted on this PC with Windows DPAPI." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Server" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SqlServer, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Database" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SqlDatabase, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Use Windows (integrated) authentication" Margin="0,2,0,12"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding SqlUseIntegratedSecurity}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="User ID" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SqlUserId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                    <PasswordBox x:Name="SqlPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,16" PasswordChanged="SqlPasswordBox_PasswordChanged" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Test connection"
                                Command="{Binding TestSqlCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="10,0,0,0"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ M365 ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Microsoft 365 connection" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Sign in interactively with your own admin account. All changes are performed under your identity and audited by Microsoft. Requires an Entra ID app registration." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tenant ID" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Application (Client) ID" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Default UPN domain" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. global.ul.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Used to complete a bare SamAccountName (e.g. 'jdoe' becomes 'jdoe@global.ul.com') when adding group members or resolving an owner. This is the sign-in (UPN) domain - can differ from the mail domain below." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Default mail domain" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding DefaultMailDomain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. ul.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Pre-selected address domain when creating a shared mailbox (e.g. 'ul.com'). Usually different from the UPN domain above." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SharePoint admin center URL" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding SharePointAdminUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://contoso-admin.sharepoint.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Used by the Teams feature to lock down site sharing on internal teams." />

                    <Button Style="{StaticResource PrimaryButton}" Content="Sign in and test"
                            HorizontalAlignment="Left"
                            Command="{Binding SignInM365Command}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- ============ Notification e-mail (SMTP) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Notification e-mail (SMTP)" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="Relay used for the confirmation mails sent when a shared mailbox, team or owner change is completed. Leave the host empty to fall back to sending as the signed-in admin via Microsoft Graph - that only works if the admin account has a licensed Exchange mailbox. Password is encrypted on this PC with Windows DPAPI." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SMTP server" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. smtp-relay.contoso.com" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="120" HorizontalAlignment="Left"
                                     Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="Use TLS (STARTTLS)" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                  FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                                  IsChecked="{Binding SmtpUseSsl}"
                                  ToolTip="Usually off for an internal relay on port 25, on for port 587." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sender address" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding SmtpFromAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. messaging-team@contoso.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Every notification is sent from this address. The relay has to allow it as a sender." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sender display name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SmtpFromDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. Enterprise Messaging Services Team" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reply-To (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SmtpReplyToAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Where replies should go, if not the sender address" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bcc (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding SmtpBccAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma- or semicolon-separated" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="Blind-copies every notification, e.g. to a team mailbox for the record." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="User name (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding SmtpUserName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password (optional)" Margin="0,8,0,0" />
                    <PasswordBox x:Name="SmtpPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,4" PasswordChanged="SmtpPasswordBox_PasswordChanged" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="Leave both empty for a relay that authorises by IP address - nothing is sent to the server then, it connects anonymously. Fill them in only if your relay requires SMTP AUTH." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Send a test message to" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="280"
                                 Text="{Binding SmtpTestRecipient, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Your own address - the test uses the settings currently entered here" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Send test" Margin="10,0,0,0"
                                Command="{Binding SendTestMailCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="10,0,0,0"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Shared Mailboxes ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Shared mailboxes" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Optional. If set, applied to every newly created shared mailbox. Leave empty to skip this step (the legacy tenant-specific policy names won't exist in every tenant)." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Retention policy name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SharedMailboxRetentionPolicyName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exact name of an existing Exchange retention policy, e.g. 'Default MRM Policy'" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Role assignment policy name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"
                             Text="{Binding SharedMailboxRoleAssignmentPolicyName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exact name of an existing Exchange role assignment policy" />

                    <TextBlock Style="{StaticResource H2}" FontSize="14" Margin="0,4,0,0"
                               Text="Confirmation e-mail links" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Knowledge-base articles linked from the mails sent after a mailbox is created or its owners change. Taken from the legacy Outlook templates - verify they still resolve. Leave a field empty to drop that link from the mail." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Editing group membership (URL)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SharedMailboxGroupMembershipHelpUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Linked where the mail explains the .ED/.AU/.RE access groups" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Further help links" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="90"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding SharedMailboxHelpLinks, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="One link per line, written as Label|URL. Listed at the end of both confirmation mails." />

                    <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>

            <!-- ============ Room & resource mailboxes ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Room &amp; resource mailboxes" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Defaults used when creating conference rooms and equipment/resource mailboxes. Domains fall back to the default mail domain above when left empty." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Room mailbox domain" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding RoomMailboxDomain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. contoso.onmicrosoft.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Address domain for room/equipment mailboxes themselves - typically the tenant's onmicrosoft.com domain." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Room group domain" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding RoomGroupDomain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. ul.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Address domain for the room list, delegate and authorized-users groups." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Room list / group owner" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding RoomListOwnerGroup, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Set as ManagedBy on new room lists and groups, e.g. MBX.RRS.Owner" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Global admin group" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding RoomGlobalAdminGroup, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Granted FullAccess on every new room, e.g. DBS.CRP.RRS.Admins" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Booking window (days)" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="120" HorizontalAlignment="Left"
                                     Text="{Binding RoomBookingWindowDays, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Max duration (minutes)" />
                            <TextBox Style="{StaticResource ModernTextBox}" Width="120" HorizontalAlignment="Left"
                                     Text="{Binding RoomMaximumDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>

            <!-- ============ Teams policies ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Teams policies" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="Entra groups that carry a Teams meeting policy - recording, transcription, Copilot. The Teams Policies page only ever looks at groups whose display name starts with one of these prefixes; the rest of the directory is ignored." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Policy group prefixes" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="80"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding TeamsPolicyGroupPrefixes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="One prefix per line, e.g. POL.Teams.MTG. - include the trailing dot. Each line is its own category: a user holds at most one group per prefix, and assigning within a prefix replaces whatever they had from that same prefix. Groups under a different prefix are never touched." />

                    <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>

            <!-- ============ New Hire (telephony) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="New Hire (telephony)" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="The number inventory - sites, DID ranges, blocked numbers, endpoints - lives in a separate, long-standing telephony database on the SAME server as the one above, so only its name is needed here. Server and credentials are reused from the SQL Server section." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Telephony database" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="260"
                                 Text="{Binding NewHireDatabase, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. uchelper" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Test connection" Margin="10,0,0,0"
                                Command="{Binding TestNewHireSqlCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="{Binding NewHireStatusMessage}" />

                    <CheckBox Content="Write the SIP address and line URI to on-premises Active Directory"
                              Margin="0,2,0,4"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding NewHireWriteAdAttributes}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Leave this on while Entra Connect still synchronises the msRTCSIP-* attributes: on-premises is then the authoritative source, and a number assigned only in Teams gets overwritten - or cleared - on the next sync cycle. Writing both sides with the same value makes the sync a no-op. Turn it off only once those attributes are no longer synchronised. The write runs as your own Windows account over Kerberos; no credentials are stored." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Domain controller (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding NewHireLdapServer, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. dc01.corp.contoso.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Leave empty on a domain-joined machine - the domain and its search base are then discovered automatically." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Deployment locator" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding NewHireDeploymentLocator, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. sipfed.online.lync.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Written to msRTCSIP-DeploymentLocator, which marks the account as homed online." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Phone number type" />
                    <TextBox Style="{StaticResource ModernTextBox}" Width="260" HorizontalAlignment="Left"
                             Margin="0,0,0,4"
                             Text="{Binding NewHirePhoneNumberType, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="DirectRouting, CallingPlan or OperatorConnect" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Passed to Set-CsPhoneNumberAssignment. DirectRouting for numbers from your own SBC." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Teams upgrade policy" />
                    <TextBox Style="{StaticResource ModernTextBox}" Width="260" HorizontalAlignment="Left"
                             Margin="0,0,0,4"
                             Text="{Binding NewHireTeamsUpgradePolicyName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. UpgradeToTeams" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Granted to every new hire. The four voice policies are not configured here - they are always named after the site's location code." />

                    <CheckBox Content="Tell the employee their new number by e-mail" Margin="0,2,0,12"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding NewHireNotifyEmployee}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Telephony team address (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding NewHireAdminNotificationAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. telephony-team@contoso.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Notified when a run does not complete cleanly, so somebody picks up the half-configured account. Comma- or semicolon-separated. Empty skips the notice." />

                    <Button Style="{StaticResource SecondaryButton}" Content="Save" HorizontalAlignment="Left"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>

            <!-- ============ Trace application ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Trace application" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Used when inviting customers as Entra guest accounts for Trace." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Company name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding TraceCompanyName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. EXT-CALLIS" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Stamped onto every invited guest, and what the guest overview filters on." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Redirect URL" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding TraceRedirectUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://trace.ul.com" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Where the invitation link sends the guest after they accept." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Invitation e-mail text" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="200"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding TraceInvitationMessage, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Sent by Microsoft with the invitation. {RedirectUrl} and {DisplayName} are replaced before sending; everything else - including the signature - is used literally." />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Save"
                                Command="{Binding SaveCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Reset text" Margin="10,0,0,0"
                                Command="{Binding ResetTraceInvitationMessageCommand}"
                                ToolTip="Restores the wording from the original invite script" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Room & resource sites ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Room &amp; resource sites" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,4"
                               Text="Maps the site code that prefixes every room name to its calendar time zone and regional admin group. Replaces the old RoomTimeZones.csv. Edit cells directly, then click 'Save changes'." />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Stored in the SQL table dbo.RoomSites - run src/M365Manager.Data/Scripts/06_RoomResources.sql once against the database before using this. 'Import CSV...' loads the old RoomTimeZones.csv in one go." />

                    <DataGrid ItemsSource="{Binding RoomSites}"
                              SelectedItem="{Binding SelectedRoomSite, Mode=TwoWay}"
                              MaxHeight="260" Margin="0,0,0,12"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                              Background="Transparent" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}"
                              VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Site" Width="70" Binding="{Binding SiteCode}" />
                            <DataGridTextColumn Header="Time zone" Width="*" Binding="{Binding TimeZone}" />
                            <DataGridTextColumn Header="Region" Width="70" Binding="{Binding Region}" />
                            <DataGridTextColumn Header="Regional admin group" Width="*" Binding="{Binding RegionalAdminGroup}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Save changes" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveRoomSiteChangesCommand}" />
                        <Button Content="Delete selected" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                Command="{Binding DeleteRoomSiteCommand}" />
                        <Button Content="Import CSV..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                Command="{Binding ImportRoomSitesCommand}"
                                ToolTip="Import the legacy RoomTimeZones.csv (columns Code, Zone, Admins)" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="70"
                                 Text="{Binding NewSiteCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Site code, e.g. NBK" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="200" Margin="8,0,0,0"
                                 Text="{Binding NewSiteTimeZone, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Windows time zone id, e.g. W. Europe Standard Time" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="60" Margin="8,0,0,0"
                                 Text="{Binding NewSiteRegion, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Region, e.g. EU" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="180" Margin="8,0,0,0"
                                 Text="{Binding NewSiteAdminGroup, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Regional admin group, e.g. MBX.EU.RRS.Admins" />
                        <Button Content="Add" Style="{StaticResource SecondaryButtonSmall}" Margin="8,0,0,0"
                                Command="{Binding AddRoomSiteCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding RoomSiteStatusMessage}" />
                </StackPanel>
            </Border>

            <!-- ============ Team naming acronyms ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Team naming acronyms" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                               Text="Applied to the team name (GRP.&lt;Location&gt;.&lt;Name&gt;) when creating a team. Edit cells directly, then click 'Save changes'." />

                    <DataGrid ItemsSource="{Binding Acronyms}"
                              SelectedItem="{Binding SelectedAcronym, Mode=TwoWay}"
                              MaxHeight="260" Margin="0,0,0,12"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                              Background="Transparent" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}"
                              VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Acronym" Width="*" Binding="{Binding Acronym}" />
                            <DataGridTextColumn Header="Translation" Width="*" Binding="{Binding Translation}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Save changes" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveAcronymChangesCommand}" />
                        <Button Content="Delete selected" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                Command="{Binding DeleteAcronymCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="200"
                                 Text="{Binding NewAcronym, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="New acronym" />
                        <TextBox Style="{StaticResource ModernTextBox}" Width="200" Margin="8,0,0,0"
                                 Text="{Binding NewTranslation, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="New translation" />
                        <Button Content="Add" Style="{StaticResource SecondaryButtonSmall}" Margin="8,0,0,0"
                                Command="{Binding AddAcronymCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding AcronymStatusMessage}" />
                </StackPanel>
            </Border>

            <!-- ============ Status ============ -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="{Binding SettingsFilePath, StringFormat='Settings file: {0}'}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
