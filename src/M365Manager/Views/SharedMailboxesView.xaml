<UserControl x:Class="M365Manager.Views.SharedMailboxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:sm="clr-namespace:M365Manager.Core.SharedMailboxes;assembly=M365Manager.Core"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <!--
        Was four forms and a grid stacked in one scroll column, each asking for the mailbox
        identity again. Now the overview is the entry point - pick the row, and the manage forms
        already know which mailbox you mean.
    -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="OwnerChangeModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="sm:OwnerChangeMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <TabControl Style="{StaticResource TabStrip}" Padding="0"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
        </TabControl.Resources>

        <!-- ================================================================
             Find & manage
             ================================================================ -->
        <TabItem Header="Find &amp; manage">
            <Grid Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter + grid actions -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                                 AutomationProperties.Name="Filter shared mailboxes"
                                 Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="_Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding RefreshOverviewCommand}"
                                IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="_Export Excel" Style="{StaticResource GhostButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding ExportToExcelCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Filter by name, alias, address or owner. Read from the SQL cache, not live from M365 - refreshed automatically after a change here." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                 Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <!-- Grid | manage panel -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="440" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SharedMailboxes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                           Text="No shared mailboxes in the cache. Check the SQL connection in Settings, or run the scheduled import." />
                            </StackPanel>

                            <!-- Collapsed while empty so the empty state behind it is visible: the
                                 grid paints an opaque background and would otherwise hide it. -->
                            <DataGrid ItemsSource="{Binding SharedMailboxesOverviewView}"
                                      SelectedItem="{Binding SelectedMailbox, Mode=TwoWay}"
                                      AutomationProperties.Name="Shared mailboxes">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SharedMailboxes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <!-- Star widths, not fixed ones: the panel on the right leaves
                                         about 500px here, and fixed columns squeezed the name
                                         column down to a single letter. -->
                                    <DataGridTextColumn Header="Mailbox" Width="2*" MinWidth="140" Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="Address" Width="2*" MinWidth="160" Binding="{Binding PrimarySmtpAddress}" />
                                    <DataGridTextColumn Header="Owner(s)" Width="*" MinWidth="110" Binding="{Binding Owners}" />
                                    <DataGridCheckBoxColumn Header="Deleted" Width="64" Binding="{Binding IsDeletedInM365}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!--
                        The manage panel is NOT gated on a grid selection. Selecting a row is a
                        shortcut that fills the identity field; a mailbox that is missing from the
                        SQL cache - created outside the app, or not imported yet - must still be
                        reachable by typing its address, the way it always was.
                    -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding SelectedMailbox, Converter={StaticResource NullToCollapsed}}">
                            <!-- Carries the columns the grid no longer has room for - alias, the
                                 three access-group addresses and the creation date - so nothing
                                 the overview used to show is lost. -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedMailbox.DisplayName}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                                           Text="{Binding SelectedMailbox.PrimarySmtpAddress}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="Owners" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.Owners}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="Alias" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.Alias}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text=".ED group" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.EDGroupAddress}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Muted}" Text=".AU group" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.AUGroupAddress}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Muted}" Text=".RE group" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.REGroupAddress}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Muted}" Text="Created" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedMailbox.CreatedDateTime}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <TabControl Style="{StaticResource TabStrip}" Margin="16,4,16,12">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
                                </TabControl.Resources>

                                <!-- Owners -->
                                <TabItem Header="Owners">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding ChangeOwnerTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Shared mailbox" />
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     AutomationProperties.Name="Shared mailbox to change owners on"
                                                     Text="{Binding ChangeOwnerMailboxAddress, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                                       Text="Filled in when you pick a row on the left. You can also type a display name or address directly - useful for a mailbox the cache does not know yet." />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Owner identities" />
                                            <TextBox AutomationProperties.Name="Owner identities" Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding ChangeOwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                                       Text="Comma-separated SamAccountName, UPN or e-mail address." />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                                            <ComboBox AutomationProperties.Name="Mode" Style="{StaticResource ModernComboBox}" Width="160"
                                                      HorizontalAlignment="Left" Margin="{DynamicResource GapField}"
                                                      ItemsSource="{Binding Source={StaticResource OwnerChangeModes}}"
                                                      SelectedItem="{Binding ChangeOwnerMode}" />

                                            <Button Style="{StaticResource PrimaryButton}" Content="_Change owner"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding ChangeOwnerCommand}"
                                                    IsEnabled="{Binding IsChangingOwner, Converter={StaticResource InverseBool}}" />

                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                                                       Text="Applies to whichever of the mailbox's .ED/.AU/.RE access groups exist, then refreshes their MailTip and notifies the resulting owners." />

                                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                                         Visibility="{Binding IsChangingOwner, Converter={StaticResource BoolToVisible}}" />
                                            <controls:AlertBox Margin="0,12,0,0"
                                                               Text="{Binding ChangeOwnerStatusMessage}"
                                                               Severity="{Binding ChangeOwnerStatusSeverity}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Rename -->
                                <TabItem Header="Rename">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RenameTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Shared mailbox" />
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     AutomationProperties.Name="Shared mailbox to rename"
                                                     Text="{Binding RenameMailboxIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                       Text="Filled in when you pick a row on the left, or type a display name or address directly." />

                                            <Button Style="{StaticResource SecondaryButton}" Content="_Look up mailbox"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                                    Command="{Binding LookUpRenameMailboxCommand}"
                                                    IsEnabled="{Binding IsRenameLookupBusy, Converter={StaticResource InverseBool}}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12"
                                                       Text="Reads the mailbox back from Exchange so the rename knows which access groups it has." />

                                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                                    Visibility="{Binding HasRenamePreview, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Currently" />
                                                    <TextBlock Style="{StaticResource Muted}"
                                                               Text="{Binding RenameCurrentSummary}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="New location" />
                                            <TextBox AutomationProperties.Name="New location" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RenameLocation, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
                                            <TextBox AutomationProperties.Name="New name" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}" />

                                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="New display name" />
                                                    <TextBox AutomationProperties.Name="New display name" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                                             Text="{Binding RenameNewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="New e-mail address" />
                                                    <TextBox AutomationProperties.Name="New e-mail address" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                                             Text="{Binding RenameNewAddress, UpdateSourceTrigger=PropertyChanged}" />

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                                   Text="Built on the mailbox's current domain." />
                                                        <Button Content="Re_set" Style="{StaticResource GhostButtonSmall}"
                                                                Margin="{DynamicResource GapInline}"
                                                                Command="{Binding ResetRenamePreviewCommand}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Margin="0,0,0,16"
                                                        Visibility="{Binding RenameGroupSummary, Converter={StaticResource EmptyToCollapsed}}">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Access groups to be renamed" />
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding RenameGroupSummary}" />
                                            </StackPanel>

                                            <Button Style="{StaticResource DangerButton}" Content="_Rename mailbox"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding RenameSharedMailboxCommand}"
                                                    IsEnabled="{Binding IsRenaming, Converter={StaticResource InverseBool}}" />

                                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisible}}" />
                                            <controls:AlertBox Margin="0,12,0,0"
                                                               Text="{Binding RenameStatusMessage}"
                                                               Severity="{Binding RenameStatusSeverity}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Remove -->
                                <TabItem Header="Remove">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                                     Text="{Binding RemoveTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Shared mailbox" />
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     AutomationProperties.Name="Shared mailbox to remove"
                                                     Text="{Binding RemoveMailboxIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                                       Text="Filled in when you pick a row on the left, or type a display name or address directly." />

                                            <Button Style="{StaticResource SecondaryButton}" Content="_Look up mailbox"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                                    Command="{Binding LookUpRemovalMailboxCommand}"
                                                    IsEnabled="{Binding IsRemoveLookupBusy, Converter={StaticResource InverseBool}}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12"
                                                       Text="Shows the owners, access groups with their members, forwarding and direct permissions - everything that goes with the mailbox." />

                                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                                    Visibility="{Binding HasRemovalPreview, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Will be removed" />
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                               Text="{Binding RemovalSummary}" />
                                                </StackPanel>
                                            </Border>

                                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"
                                                      Content="Also delete its .ED/.AU/.RE access groups"
                                                      IsChecked="{Binding RemoveDeleteAccessGroups}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16"
                                                       Text="The groups exist only for this mailbox. Deleted groups are gone for good - a recovery recreates them from the snapshot." />

                                            <Button Style="{StaticResource DangerButton}" Content="_Delete shared mailbox"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding RemoveSharedMailboxCommand}"
                                                    IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}" />

                                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                                                       Text="A full snapshot is written to the log first, and the owners get a confirmation e-mail. The mailbox stays recoverable for 30 days." />

                                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                                         Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVisible}}" />
                                            <controls:AlertBox Margin="0,12,0,0"
                                                               Text="{Binding RemoveStatusMessage}"
                                                               Severity="{Binding RemoveStatusSeverity}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>

                <controls:AlertBox Grid.Row="2" Margin="0,12,0,0"
                                   Text="{Binding OverviewStatusMessage}" Severity="{Binding OverviewStatusSeverity}" />

            </Grid>
        </TabItem>

        <!-- ================================================================
             Create
             ================================================================ -->
        <TabItem Header="Create shared mailbox">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,32" MaxWidth="{StaticResource ContentWidth}" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Creates the mailbox with IMAP/POP disabled and up to three access-level security groups (.ED/.AU/.RE) whose members get Editor/Author/Reader access and whose owners can manage that membership. The owners get a confirmation e-mail." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Required - authorizes this creation, e.g. TASK0012345." />

                            <Grid Margin="{DynamicResource GapField}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Location" />
                                    <TextBox AutomationProperties.Name="Location" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="e.g. HQ" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox AutomationProperties.Name="Name" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Address domain" />
                            <ComboBox AutomationProperties.Name="Address domain" Style="{StaticResource ModernComboBox}" Margin="{DynamicResource GapField}"
                                      Width="260" HorizontalAlignment="Left"
                                      ItemsSource="{Binding AvailableDomains}"
                                      Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />

                            <Border Style="{StaticResource Inset}" Margin="0,4,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Display name" />
                                    <TextBox AutomationProperties.Name="Display name" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                             Text="{Binding PreviewName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail address" />
                                    <TextBox AutomationProperties.Name="E-mail address" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                             Text="{Binding PreviewAddress, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="Generated from the fields above. Edit them and they stop updating." />
                                        <Button Content="Re_set" Style="{StaticResource GhostButtonSmall}"
                                                Margin="{DynamicResource GapInline}"
                                                Command="{Binding ResetPreviewCommand}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="The access group names follow the display name, e.g. MBX.&lt;display name&gt;.ED" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Owner(s)" />
                            <TextBox AutomationProperties.Name="Owner(s)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding OwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Comma-separated SamAccountName, UPN or e-mail address. Authorized to manage the access groups' membership below." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".ED members (Editor - Full Access + Send As)" />
                            <TextBox AutomationProperties.Name=".ED members (Editor - Full Access + Send As)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding EditorMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Always created. The owner(s) above are added as members automatically - list only additional people here. Owners listed under .AU or .RE are left out there, since everyone belongs only in the group with the highest access." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".AU members (Author - Send on Behalf)" />
                            <TextBox AutomationProperties.Name=".AU members (Author - Send on Behalf)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding AuthorMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Only created when you name at least one member." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".RE members (Reader - read-only)" />
                            <TextBox AutomationProperties.Name=".RE members (Reader - read-only)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ReaderMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Only created when you name at least one member." />

                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,20"
                                      Content="Allow external senders"
                                      IsChecked="{Binding AllowExternalSenders}" />

                            <Button Style="{StaticResource PrimaryButton}" Content="_Create shared mailbox"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CreateSharedMailboxCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <controls:AlertBox Margin="0,16,0,0"
                                       Text="{Binding StatusMessage}" Severity="{Binding StatusSeverity}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================================================================
             Recover
             ================================================================ -->
        <TabItem Header="Recover deleted mailbox">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,32" MaxWidth="{StaticResource ContentWidth}" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="A removed shared mailbox stays recoverable for 30 days. Its access groups do not come back with it - they are recreated here, with the owners and members you enter. If this app removed the mailbox, those are prefilled from its snapshot. The owners get a confirmation e-mail." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}" Margin="{DynamicResource GapField}"
                                     Text="{Binding RecoverTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"
                                           Text="Deleted shared mailboxes" />
                                <Button Content="_Load deleted mailboxes" Style="{StaticResource SecondaryButtonSmall}"
                                        Margin="{DynamicResource GapInline}"
                                        Command="{Binding LoadDeletedMailboxesCommand}"
                                        IsEnabled="{Binding IsLoadingDeleted, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,8"
                                         Visibility="{Binding IsLoadingDeleted, Converter={StaticResource BoolToVisible}}" />

                            <Border Style="{StaticResource Inset}" Padding="0" Height="220" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Margin="16" TextWrapping="Wrap"
                                               VerticalAlignment="Center" TextAlignment="Center"
                                               Text="{Binding DeletedListHint}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeletedMailboxes.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <DataGrid ItemsSource="{Binding DeletedMailboxes}"
                                              SelectedItem="{Binding SelectedDeletedMailbox, Mode=TwoWay}"
                                              AutomationProperties.Name="Deleted shared mailboxes">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeletedMailboxes.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mailbox" Width="2*" Binding="{Binding DisplayName}" />
                                            <DataGridTextColumn Header="Address" Width="2*" Binding="{Binding PrimarySmtpAddress}" />
                                            <DataGridTextColumn Header="Deleted" Width="*" Binding="{Binding WhenSoftDeleted, StringFormat='yyyy-MM-dd HH:mm'}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <controls:AlertBox Margin="0,0,0,16" Severity="Info"
                                               Text="{Binding RecoverPrefillNote}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Owner(s)" />
                            <TextBox AutomationProperties.Name="Owner(s)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RecoverOwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Comma-separated SamAccountName, UPN or e-mail address. Required - they manage the recreated groups and are added to .ED." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".ED members (Editor - Full Access + Send As)" />
                            <TextBox AutomationProperties.Name=".ED members (Editor - Full Access + Send As)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RecoverEditorMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Always recreated. The owner(s) are added automatically." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".AU members (Author - Send on Behalf)" />
                            <TextBox AutomationProperties.Name=".AU members (Author - Send on Behalf)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RecoverAuthorMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Only recreated when you name at least one member." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text=".RE members (Reader - read-only)" />
                            <TextBox AutomationProperties.Name=".RE members (Reader - read-only)" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RecoverReaderMembers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,20"
                                       Text="Only recreated when you name at least one member." />

                            <Button Style="{StaticResource PrimaryButton}" Content="_Restore mailbox"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RecoverSharedMailboxCommand}"
                                    IsEnabled="{Binding IsRecovering, Converter={StaticResource InverseBool}}" />

                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                         Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Border>

                    <controls:AlertBox Margin="0,16,0,0"
                                       Text="{Binding RecoverStatusMessage}" Severity="{Binding RecoverStatusSeverity}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

