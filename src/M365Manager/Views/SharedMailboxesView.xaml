<UserControl x:Class="M365Manager.Views.SharedMailboxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:sm="clr-namespace:M365Manager.Core.SharedMailboxes;assembly=M365Manager.Core"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="820">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="OwnerChangeModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="sm:OwnerChangeMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="Create Shared Mailbox" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Creates a shared mailbox the same way the legacy PowerShell tool did: enforced naming, IMAP/POP disabled, and three access-level security groups (.ED/.AU/.RE) whose members get Editor/Author/Reader access and whose owner(s) can manage that membership. A confirmation e-mail is sent to the owner(s) automatically." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Required - authorizes this creation, e.g. TASK0012345." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Location" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="First segment of the enforced mailbox name, e.g. HQ." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Address domain" />
                    <ComboBox Margin="0,0,0,4" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableDomains}"
                              Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" />

                    <!-- Computed from Location + Name, but editable: some names can't be derived
                         correctly, and the legacy dialog let the operator correct them too. -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Display name" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                     Text="{Binding PreviewName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail address" />
                            <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                     Text="{Binding PreviewAddress, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Text="These are generated from the fields above. Edit them and they stop updating." />
                                <Button Content="Reset" Style="{StaticResource SecondaryButtonSmall}" Margin="10,0,0,0"
                                        Command="{Binding ResetPreviewCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="The access group names follow the display name, e.g. MBX.&lt;display name&gt;.ED" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner(s)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding OwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="Comma-separated SamAccountName, UPN or e-mail address. Authorized to manage the .ED/.AU/.RE access groups' membership below." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text=".ED members (Editor - Full Access + Send As)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding EditorMembers, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Comma-separated identities. Always created. If left empty, the owner(s) above become its members." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text=".AU members (Author - Send on Behalf)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding AuthorMembers, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Comma-separated identities. Only created when you name at least one member." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text=".RE members (Reader - read-only)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ReaderMembers, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="Comma-separated identities. Only created when you name at least one member." />

                    <CheckBox Content="Allow external senders" Margin="0,10,0,16"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding AllowExternalSenders}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Create Shared Mailbox"
                            HorizontalAlignment="Left"
                            Command="{Binding CreateSharedMailboxCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- ============ Change owner ============ -->
            <TextBlock Style="{StaticResource H2}" Text="Change Owner" Margin="0,32,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Adds, removes or replaces the owner(s) on whichever of the mailbox's .ED/.AU/.RE access groups exist, then refreshes their MailTip/Notes, the mailbox's own MailTip, and sends the resulting owner(s) a confirmation e-mail." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding ChangeOwnerTaskNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Shared mailbox" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ChangeOwnerMailboxAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Display name or SMTP address - e.g. HQ Facilities or HQ.Facilities@contoso.com. An alias or UPN works too. If a display name matches more than one mailbox, the address is asked for instead." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner identities" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding ChangeOwnerIdentities, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Comma-separated. SamAccountName, UPN or e-mail address." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                    <ComboBox Margin="0,0,0,16" Width="160" HorizontalAlignment="Left"
                              ItemsSource="{Binding Source={StaticResource OwnerChangeModes}}"
                              SelectedItem="{Binding ChangeOwnerMode}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Change Owner"
                            HorizontalAlignment="Left"
                            Command="{Binding ChangeOwnerCommand}"
                            IsEnabled="{Binding IsChangingOwner, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ChangeOwnerStatusMessage}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- ============ Shared Mailboxes overview (read from SQL cache) ============ -->
        <TextBlock Style="{StaticResource H2}" Text="Shared mailboxes overview" Margin="0,32,0,4" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Read directly from the SQL cache (dbo.SharedMailboxes), never live from M365. Refreshed automatically after you create a mailbox or change an owner here; otherwise kept current by the scheduled Import-SharedMailboxesToSql.ps1 script." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                     Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding RefreshOverviewCommand}"
                    IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
            <Button Content="Export Excel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding ExportToExcelCommand}" />
        </StackPanel>

        <!-- Below the row rather than under the box: the row is horizontal. -->
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Filter by name, alias, address or owner." />

        <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                     Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding SharedMailboxesOverviewView}"
                      MaxHeight="500"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                      Background="Transparent" BorderThickness="0"
                      VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mailbox" Width="200" Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="Alias" Width="140" Binding="{Binding Alias}" />
                    <DataGridTextColumn Header="Address" Width="200" Binding="{Binding PrimarySmtpAddress}" />
                    <DataGridTextColumn Header="Owner(s)" Width="180" Binding="{Binding Owners}" />
                    <DataGridTextColumn Header=".ED group" Width="180" Binding="{Binding EDGroupAddress}" />
                    <DataGridTextColumn Header=".AU group" Width="180" Binding="{Binding AUGroupAddress}" />
                    <DataGridTextColumn Header=".RE group" Width="180" Binding="{Binding REGroupAddress}" />
                    <DataGridCheckBoxColumn Header="Deleted" Width="70" Binding="{Binding IsDeletedInM365}" />
                    <DataGridTextColumn Header="Created" Width="130" Binding="{Binding CreatedDateTime}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding OverviewStatusMessage}" />

        <!-- ============ PowerShell console ============ -->
        <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
