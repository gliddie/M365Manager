<UserControl x:Class="M365Manager.Views.TeamsPoliciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M365Manager.ViewModels"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="Teams meeting policies" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="Shows which policy groups a user is a member of, and assigns a different one. Teams applies the policy - recording, transcription, Copilot - to whoever is a member of the group. Only groups whose name starts with a configured prefix are listed; everything else in the directory is ignored." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <!-- ============ Look up ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="360"
                                 Text="{Binding UserIdentity, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Look up" Margin="10,0,0,0"
                                Command="{Binding LookUpCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <!-- Below the row rather than under the box: the row is horizontal. -->
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="SamAccountName, UPN or e-mail address." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Width="360" HorizontalAlignment="Left"
                             Margin="0,0,0,4"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Required to change an assignment; recorded in the log." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,10"
                       Text="{Binding UserSummary}"
                       Visibility="{Binding UserSummary, Converter={StaticResource EmptyToCollapsed}}" />

            <!-- ============ One card per configured prefix ============ -->
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PolicyCategoryViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,8"
                                           Text="{Binding Prefix}" />

                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"
                                           Text="{Binding CurrentText, StringFormat='Currently assigned: {0}'}" />

                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#B45309"
                                           Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisible}}"
                                           Text="This user is in more than one group under this prefix. Assigning one below removes the others." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Assign" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox Width="420" ItemsSource="{Binding AvailableGroups}"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              FontFamily="Segoe UI" FontSize="13" />
                                    <Button Style="{StaticResource SecondaryButtonSmall}" Content="Clear" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Empties the picker - Apply then removes the user from this category without assigning another group" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding HasPendingConfirmation, Converter={StaticResource BoolToCollapsed}}">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Apply"
                                            Command="{Binding DataContext.PrepareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="Leave the box empty to remove the user from this category." />
                                </StackPanel>

                                <!-- Confirmation step: the removal of the previous group is the part
                                     worth seeing before it happens. -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12"
                                        Visibility="{Binding HasPendingConfirmation, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding PendingConfirmation}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Confirm"
                                                    Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.CancelPendingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Status ============ -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>

            <!-- ============ Console ============ -->
            <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
