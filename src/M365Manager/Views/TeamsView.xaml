<UserControl x:Class="M365Manager.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <!--
        Teams themselves have no management actions - only create and look up: overview first (that
        is what you reach for when a ticket names a team), creating on the second tab. Selecting a
        row fills a detail card with the attributes the grid has no room for, rather than the
        ten-column grid the page used to show. The third tab manages the tenant-wide external
        access (federation) allow list - partner domains, not individual teams.
    -->
    <TabControl Style="{StaticResource TabStrip}" Padding="0"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource TabStripItem}" />
        </TabControl.Resources>

        <TabItem Header="Overview">
            <Grid Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                                 AutomationProperties.Name="Filter teams"
                                 Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="_Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding RefreshTeamsOverviewCommand}"
                                IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="_Export Excel" Style="{StaticResource GhostButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding ExportTeamsToExcelCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Filter by name, alias, address, owner or visibility. Read from the SQL cache, not live from M365 - kept current by the scheduled import." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                 Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Teams.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                           Text="No teams in the cache. Check the SQL connection in Settings, or run the scheduled import." />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding TeamsOverviewView}"
                                      SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                                      AutomationProperties.Name="Teams">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Teams.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Team" Width="2*" MinWidth="140" Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="Address" Width="2*" MinWidth="160" Binding="{Binding PrimarySmtpAddress}" />
                                    <DataGridTextColumn Header="Owner(s)" Width="*" MinWidth="110" Binding="{Binding Owners}" />
                                    <DataGridTextColumn Header="Members" Width="76" Binding="{Binding MemberCount}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding SelectedTeam, Converter={StaticResource NotNullToCollapsed}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                                       Text="Select a team to see its settings." />
                        </StackPanel>
                    </Border>

                    <!-- Everything the old ten-column grid showed, where it is actually readable. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding SelectedTeam, Converter={StaticResource NullToCollapsed}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedTeam.DisplayName}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                                           Text="{Binding SelectedTeam.PrimarySmtpAddress}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="Alias" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.Alias}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="Owner(s)" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.Owners}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text="Visibility" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.Visibility}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Muted}" Text="Members" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.MemberCount}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Muted}" Text="Archived" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.IsArchived}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Muted}" Text="Guests" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.AllowToAddGuests}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Muted}" Text="Hidden" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.HiddenFromAddressListsEnabled}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Muted}" Text="Welcome msg" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.WelcomeMessageEnabled}" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Muted}" Text="Created" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SelectedTeam.CreatedDateTime}" />
                                </Grid>

                                <Border Margin="0,12,0,0" Padding="8,3" HorizontalAlignment="Left"
                                        CornerRadius="{DynamicResource RadiusPill}"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedTeam.IsDeletedInM365, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="Deleted in M365" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>

                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                                           Text="{Binding SelectedTeam.SharePointSiteUrl}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <controls:AlertBox Grid.Row="2" Margin="0,12,0,0"
                                   Text="{Binding OverviewStatusMessage}" Severity="{Binding OverviewStatusSeverity}" />

            </Grid>
        </TabItem>

        <TabItem Header="Create team">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,32" MaxWidth="{StaticResource ContentWidth}" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Creates a Microsoft Team the same way the legacy PowerShell tool did: enforced naming, owner licensing check, hidden from the address book, welcome message disabled, guest access and SharePoint sharing controlled by Internal/External, and an owner confirmation e-mail." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                            <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="Required - authorizes this creation, e.g. TASK0012345." />

                            <Grid Margin="{DynamicResource GapField}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Location" />
                                    <TextBox AutomationProperties.Name="Location" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="Middle segment, e.g. HQ" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox AutomationProperties.Name="Name" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16"
                                    Visibility="{Binding PreviewName, Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Final team name" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding PreviewName}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                            <TextBox AutomationProperties.Name="Description" Style="{StaticResource ModernTextBoxMultiline}" Height="70"
                                     Margin="{DynamicResource GapField}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Owner" />
                            <TextBox AutomationProperties.Name="Owner" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding OwnerIdentity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                       Text="SamAccountName, UPN or e-mail address. Must have a licensed mailbox. Becomes the sole owner of the new team - you are not added as a member." />

                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"
                                      Content="Public group"
                                      IsChecked="{Binding IsPublic}" />

                            <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,0,0,20"
                                      Content="Internal (disables guest access and locks down SharePoint site sharing)"
                                      IsChecked="{Binding IsInternal}" />

                            <Button Style="{StaticResource PrimaryButton}" Content="_Create team"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CreateTeamCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <controls:AlertBox Margin="0,16,0,0"
                                       Text="{Binding StatusMessage}" Severity="{Binding StatusSeverity}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--
            External access (federation): which partner domains Teams users may chat, call and
            meet with. One tenant-wide list, read live from Teams - list on the left, the mode it
            is in and the add/remove actions on the right.
        -->
        <TabItem Header="External access">
            <Grid Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                                 AutomationProperties.Name="Filter allowed domains"
                                 Text="{Binding FederationFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="_Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="{DynamicResource GapInline}"
                                Command="{Binding RefreshFederationCommand}"
                                IsEnabled="{Binding IsFederationBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Partner domains on the Teams federation allow list. Read live from Teams, not from the SQL cache." />

                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,12,0,0"
                                 Visibility="{Binding IsFederationBusy, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FederationDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding FederationListHint}" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding FederationDomainsView}"
                                      SelectedItem="{Binding SelectedFederationDomain, Mode=TwoWay}"
                                      AutomationProperties.Name="Allowed partner domains">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FederationDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Allowed domain" Width="*" Binding="{Binding}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:AlertBox Margin="0,0,0,12"
                                               Text="{Binding FederationModeText}" Severity="{Binding FederationModeSeverity}" />

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasFederationState, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                                    <TextBox AutomationProperties.Name="Ticket / task number" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding FederationTaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                                               Text="Required for adding and for removing." />

                                    <TextBlock Style="{StaticResource H3}" Text="Add partner domains" Margin="0,0,0,8" />
                                    <TextBox AutomationProperties.Name="Partner domains to add" Style="{StaticResource ModernTextBoxMultiline}" Height="80"
                                             Text="{Binding FederationDomainsInput, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanAddFederationDomains}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,12"
                                               Text="One per line or comma-separated, e.g. partner.com. A pasted web or e-mail address is reduced to its domain." />
                                    <Button Style="{StaticResource PrimaryButton}" Content="_Add domains"
                                            HorizontalAlignment="Left" Margin="0,0,0,24"
                                            Command="{Binding AddFederationDomainsCommand}"
                                            IsEnabled="{Binding CanSubmitFederationAdd}" />

                                    <TextBlock Style="{StaticResource H3}" Text="Remove a domain" Margin="0,0,0,8" />
                                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Setter Property="Text" Value="{Binding SelectedFederationDomain, StringFormat='Selected: {0}'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedFederationDomain}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="Select a domain in the list on the left." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource DangerButton}" Content="Re_move domain"
                                            HorizontalAlignment="Left"
                                            Command="{Binding RemoveFederationDomainCommand}"
                                            IsEnabled="{Binding IsFederationBusy, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:AlertBox Grid.Row="2" Margin="0,12,0,16"
                                   Text="{Binding FederationStatusMessage}" Severity="{Binding FederationStatusSeverity}" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>

