<UserControl x:Class="M365Manager.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="Create Team" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Creates a Microsoft Team the same way the legacy PowerShell tool did: enforced naming, owner licensing check, hidden from the address book, welcome message disabled, guest access and SharePoint sharing controlled by Internal/External, and an owner confirmation e-mail." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Required - authorizes this creation, e.g. TASK0012345." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Location" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Middle segment of the enforced team name, e.g. HQ." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="{Binding PreviewName, StringFormat='Final team name: {0}'}"
                               Visibility="{Binding PreviewName, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding OwnerIdentity, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- The format note is folded into the hint this field already had, rather than
                         stacking a second muted line under the first. -->
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="SamAccountName, UPN or e-mail address. Must have a licensed mailbox. Becomes the sole owner of the new team - you are not added as a member." />

                    <CheckBox Content="Public group" Margin="0,2,0,12"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding IsPublic}" />

                    <CheckBox Content="Internal (disables guest access and locks down SharePoint site sharing)"
                              Margin="0,2,0,16"
                              FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
                              IsChecked="{Binding IsInternal}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Create Team"
                            HorizontalAlignment="Left"
                            Command="{Binding CreateTeamCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <!-- ============ Teams overview (read from SQL cache) ============ -->
        <TextBlock Style="{StaticResource H2}" Text="Teams overview" Margin="0,32,0,4" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Read directly from the SQL cache (dbo.Teams), never live from M365. Refreshed automatically after you create a team here; otherwise kept current by the scheduled Import-TeamsToSql.ps1 script." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                     Text="{Binding OverviewFilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding RefreshTeamsOverviewCommand}"
                    IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
            <Button Content="Export Excel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding ExportTeamsToExcelCommand}" />
        </StackPanel>

        <!-- Below the row rather than under the box: the row is horizontal. -->
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Filter by name, alias, address, owner or visibility." />

        <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                     Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding TeamsOverviewView}"
                      MaxHeight="500"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                      Background="Transparent" BorderThickness="0"
                      VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Team" Width="220" Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="Alias" Width="140" Binding="{Binding Alias}" />
                    <DataGridTextColumn Header="Address" Width="200" Binding="{Binding PrimarySmtpAddress}" />
                    <DataGridTextColumn Header="Owner(s)" Width="180" Binding="{Binding Owners}" />
                    <DataGridTextColumn Header="Visibility" Width="80" Binding="{Binding Visibility}" />
                    <DataGridTextColumn Header="Members" Width="70" Binding="{Binding MemberCount}" />
                    <DataGridCheckBoxColumn Header="Archived" Width="70" Binding="{Binding IsArchived}" />
                    <DataGridCheckBoxColumn Header="Guests" Width="70" Binding="{Binding AllowToAddGuests}" />
                    <DataGridCheckBoxColumn Header="Hidden" Width="70" Binding="{Binding HiddenFromAddressListsEnabled}" />
                    <DataGridCheckBoxColumn Header="Welcome msg" Width="90" Binding="{Binding WelcomeMessageEnabled}" />
                    <DataGridTextColumn Header="SharePoint site" Width="220" Binding="{Binding SharePointSiteUrl}" />
                    <DataGridCheckBoxColumn Header="Deleted" Width="70" Binding="{Binding IsDeletedInM365}" />
                    <DataGridTextColumn Header="Created" Width="130" Binding="{Binding CreatedDateTime}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding OverviewStatusMessage}" />

        <!-- ============ PowerShell console ============ -->
        <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
