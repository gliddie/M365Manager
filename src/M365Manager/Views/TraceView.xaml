<UserControl x:Class="M365Manager.Views.TraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:M365Manager.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H2}" Text="Invite Trace guest account" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Invites a customer as a guest to Entra so they can sign in to Trace. Microsoft sends the invitation e-mail with the text configured under Settings; the new guest is then stamped with the company name so it can be found again." />

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{Binding CompanyName, StringFormat='Company name stamped on new guests:  {0}'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="{Binding RedirectUrl, StringFormat='Invitation redirects to:  {0}'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Both are configured under Settings > Trace application." />
                </StackPanel>
            </Border>

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Guest name" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="The name the guest is invited under, e.g. Ralf Terjung." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail address" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="The customer's own address - this is where the invitation is sent." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket / task number (optional)" />
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                             Text="{Binding TaskNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Recorded in the log when given. Leave empty if the request didn't come from a ticket." />

                    <Button Style="{StaticResource PrimaryButton}" Content="Invite guest"
                            HorizontalAlignment="Left"
                            Command="{Binding InviteCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding LastRedeemUrl, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Redemption link" />
                        <TextBox Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                 Text="{Binding LastRedeemUrl, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Copy link" Style="{StaticResource SecondaryButtonSmall}"
                                    Command="{Binding CopyRedeemUrlCommand}" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="Send this to the guest if the invitation e-mail doesn't arrive." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ============ Guest overview ============ -->
        <TextBlock Style="{StaticResource H2}" Text="Trace guest accounts" Margin="0,32,0,4" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Read live from Entra - every guest carrying the configured company name. No SQL cache and no scheduled import here, so the list is always current." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Style="{StaticResource ModernTextBox}" Width="320"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding RefreshGuestsCommand}"
                    IsEnabled="{Binding IsOverviewBusy, Converter={StaticResource InverseBool}}" />
            <Button Content="Export Excel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Command="{Binding ExportToExcelCommand}" />
        </StackPanel>

        <!-- Below the row rather than under the box: the row is horizontal, so a hint placed
             inside it would sit beside the box instead of under it. -->
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Filter by name, e-mail or status." />

        <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,12"
                     Visibility="{Binding IsOverviewBusy, Converter={StaticResource BoolToVisible}}" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding GuestsView}"
                      MaxHeight="460"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="28" FontFamily="Segoe UI" FontSize="12"
                      Background="Transparent" BorderThickness="0"
                      VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="200" Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="E-mail" Width="240" Binding="{Binding Mail}" />
                    <DataGridTextColumn Header="Status" Width="140" Binding="{Binding StatusLabel}" />
                    <DataGridTextColumn Header="Company" Width="130" Binding="{Binding CompanyName}" />
                    <DataGridCheckBoxColumn Header="Enabled" Width="70" Binding="{Binding AccountEnabled}" />
                    <DataGridTextColumn Header="Created (UTC)" Width="130"
                                        Binding="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm'}" />
                    <DataGridTextColumn Header="User principal name" Width="*" Binding="{Binding UserPrincipalName}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding OverviewStatusMessage}" />

        <!-- ============ Console ============ -->
        <controls:PowerShellConsole Margin="0,32,0,0" Transcript="{Binding Transcript}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
